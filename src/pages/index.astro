---
import Hero from "@components/sections/Hero.astro";
import Popular from "@components/sections/Popular.astro";
import { property } from "@data/property";
import Layout from "@layouts/Layout.astro";
import PrivateLoft from "@components/sections/PrivateLoft.astro";
import WhatWeDo from "@components/sections/WhatWeDo.astro";
import Video from "@components/ui/Video.astro";
import { Icon } from "astro-icon";
---

<Layout>
  <main id="Home">
    <Hero />

    <!-- POPULAR 3-->

    <Popular properties={property.slice(0, 3)} />

    <!-- COCO BEACH -->

    <PrivateLoft />

    <!-- WHAT WE CAN DO -->
    <WhatWeDo />

    <!-- POPULAR 6 -->
    <Popular properties={property.slice(3)} />

    <!-- TALENTED -->
    <section class="p-12">
      <div class="container flex flex-col">
        <h1 class="title-2">Talented and experienced Agents</h1>
        <div class="flex py-8 gap-6">
          <!-- player -->
          <div class="player w-1/2">
            <Video />
          </div>
          <div class="w-1/2 flex items-center">
            <div class="grid grid-cols-2 gap-8">
              <div class="feature-1">
                <Icon
                  name="ph:buildings-duotone"
                  class="w-9 aspect-square text-primary"
                />
                <h5 class="text-base font-TitilliumWeb font-semibold text-dark">
                  Solid Expertise
                </h5>
                <p class="text-sm text-blue-gray max-w-[15rem]">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
                  videbimus.
                </p>
              </div>
              <div class="feature-2">
                <Icon
                  name="ph:medal-duotone"
                  class="w-9 aspect-square text-primary"
                />
                <h5 class="text-base font-TitilliumWeb font-semibold text-dark">
                  Award Winning
                </h5>
                <p class="text-sm text-blue-gray max-w-[15rem]">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
                  videbimus.
                </p>
              </div>
              <div class="feature-3">
                <Icon
                  name="ph:sparkle-duotone"
                  class="w-9 aspect-square text-primary"
                />
                <h5 class="text-base font-TitilliumWeb font-semibold text-dark">
                  Creativity
                </h5>
                <p class="text-sm text-blue-gray max-w-[15rem]">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
                  videbimus.
                </p>
              </div>
              <div class="feature-4">
                <Icon
                  name="ph:gear-six-duotone"
                  class="w-9 aspect-square text-primary"
                />
                <h5 class="text-base font-TitilliumWeb font-semibold text-dark">
                  Technicity
                </h5>
                <p class="text-sm text-blue-gray max-w-[15rem]">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed
                  videbimus.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RANKING -->
    <section class="p-12">
      <div class="container flex gap-6">
        <div class="w-1/2 p-3 pl-[98px]">
          <h3 class="title-2 font-light">Highest ranking standards</h3>
          <p class="text-blue-gray text-base py-2">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Illud non
            continuo, ut aeque incontentae. Duo Reges: constructio interrete. Si
            qua in iis corrigere voluit, deteriora fecit. Sit enim idem caecus,
            debilis.
          </p>

          <ul class="py-4 pl-6">
            <li class="flex items-center gap-2 py-2">
              <Icon
                name="lucide:check"
                class="w-5 text-success aspect-square"
              />
              <span class="text-ice-blue">AA+ construction standard</span>
            </li>
            <li class="flex items-center gap-2 py-2">
              <Icon
                name="lucide:check"
                class="w-5 text-success aspect-square"
              />
              <span class="text-ice-blue">All-Risk insurance</span>
            </li>
            <li class="flex items-center gap-2 py-2">
              <Icon
                name="lucide:check"
                class="w-5 text-success aspect-square"
              />
              <span class="text-ice-blue">Project live tracking</span>
            </li>
          </ul>
        </div>
        <div class="w-1/2"></div>
      </div>
    </section>

    <!-- WHAT THEY SAY -->

    <!-- LOGOS -->
  </main>
</Layout>

