---
import { setDescription, setTitle } from "@utils/utils";
import { SEO } from "astro-seo";
import type { Props as IAstroSEO } from "astro-seo";
import NavbarSplit from "@components/NavbarSplit.astro";
import Footer from "@components/Footer.astro";
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import ScrollTop from "@components/ui/ScrollTop.astro";
interface Props extends IAstroSEO {}
const { title = "", description = "", ...props } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/images/logo/logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={setTitle(title)}
      description={setDescription(description)}
      {...props}
    />

    <GoogleFontsOptimizer
      url={[
        "https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,300;8..144,400;8..144,500;8..144,600",
        "https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap",
      ]}
    />

    <slot name="head" />
  </head>
  <body>
    <div id="Top"></div>
    <NavbarSplit />
    <slot />
    <ScrollTop />
    <Footer />
    <style is:global>
      html {
        height: 100%;
      }

      body {
        @apply h-full flex flex-col;
        font-family: "Roboto Flex", sans-serif;
      }

      .paragraph {
        @apply text-xl text-blue-gray leading-6;
      }

      .title {
        @apply dark:text-white text-2xl font-TitilliumWeb text-dark;
      }
      .title-2 {
        @apply dark:text-white font-TitilliumWeb text-dark text-[32px];
      }
    </style>

    <script>
      import Alpine from "alpinejs";

      window.Alpine = Alpine;

      Alpine.start();
    </script>

    <script>
      import { MANSORY_THEME } from "@/constants";
      import { setDarkTheme, setLightTheme, themeIsDark } from "@utils/utils";

      window.addEventListener("DOMContentLoaded", () => {
        const themeToggles = [
          ...document.querySelectorAll(".darkToggle"),
        ] as HTMLButtonElement[];

        // REMEMBER PREFERENCE OR AUTO DARK/LIGHT ON LOAD

        if (
          themeIsDark() ||
          (!(MANSORY_THEME in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          setDarkTheme();
          themeToggles.forEach((toggle) => (toggle.dataset.darkMode = "true"));
        } else {
          setLightTheme();
          themeToggles.forEach((toggle) => (toggle.dataset.darkMode = "false"));
        }

        // Handle theme toggle buttons
        themeToggles.forEach((toggle) => {
          toggle.onclick = function () {
            if (themeIsDark()) {
              setLightTheme();
              toggle.dataset.darkMode = "false";
            } else {
              setDarkTheme();
              toggle.dataset.darkMode = "true";
            }
          };
        });
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // get all videos with a class of .lazy
        const lazyVideos = [].slice.call(
          document.querySelectorAll("video.lazy")
        );
        const lazyVideoObserver = new IntersectionObserver(function (
          entries,
          observer
        ) {
          entries.forEach((videoEntry) => {
            if (videoEntry.isIntersecting) {
              // Get the video element
              const video = videoEntry.target as HTMLVideoElement;

              // Looping through video <source>
              for (const sourceIndex in video.children) {
                // get <source> at index sourceIndex
                const videoSource = video.children[
                  sourceIndex
                ] as HTMLSourceElement;
                // verify if its <source> tag
                if (
                  typeof videoSource.tagName === "string" &&
                  videoSource.tagName === "SOURCE"
                ) {
                  videoSource.src = videoSource.dataset.src as string;
                }
              }

              video.load();

              const playBtn = video.nextElementSibling as HTMLButtonElement;
              playBtn.onclick = (e) => {
                video.play();
              };

              // ON VIDEO PAUSED
              video.onpause = (event) => {
                playBtn.dataset.isPlaying = `false`;
                // HIDE CONTROLS
                video.controls = false;
              };

              // ON VIDEO PLAY
              video.onplay = (event) => {
                playBtn.dataset.isPlaying = `true`;
                // SHOW CONTROLS
                video.controls = true;
              };

              video.classList.remove("lazy");
              lazyVideoObserver.unobserve(video);
            }
          });
        });

        lazyVideos.forEach((lazyVideo) => {
          lazyVideoObserver.observe(lazyVideo);
        });
      });
    </script>
  </body>
</html>
