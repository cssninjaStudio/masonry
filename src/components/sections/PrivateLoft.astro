---
import { Picture } from "@astrojs/image/components";
import { Icon } from "astro-icon";
---

<section class="py-12 px-6 lg:p-12 dark:bg-dark-purple-1">
  <div class="container flex flex-col md:flex-row items-center">
    <div class="w-full md:w-1/2 px-[5%] lg:pl-[98px] flex flex-col gap-2">
      <span
        class="uppercase text-primary h-8 px-3 rounded border border-primary w-max grid place-items-center text-xs"
        >new offer</span
      >
      <h3 class="title-2">Coco Beach® private lofts</h3>
      <p class="text-blue-gray max-w-[27.5rem] text-base">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Illud non
        continuo, ut aeque incontentae. Duo Reges: constructio interrete. Si qua
        in iis corrigere voluit.
      </p>

      <div class="grid grid-cols-3 py-8">
        <!-- bedroom -->
        <div class="bedroom flex flex-col">
          <div class="flex items-center gap-2">
            <svg
              class="w-4 aspect-square dark:text-white"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="--darkreader-inline-stroke: currentColor;"
              data-darkreader-inline-stroke=""
              ><path d="M2 20v-8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8"></path><path
                d="M4 10V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v4"></path><path
                d="M12 4v6"></path><path d="M2 18h20"></path>
            </svg>

            <p class="text-lg font-bold dark:text-white">2</p>
          </div>

          <p class="text-sm text-ice-blue">Bedrooms</p>
        </div>
        <!-- bathroom -->
        <div class="bathroom flex flex-col">
          <div class="flex items-center gap-2">
            <svg
              class="w-4 aspect-square dark:text-white"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="--darkreader-inline-stroke: currentColor;"
              data-darkreader-inline-stroke=""
              ><path
                d="M9 6 6.5 3.5a1.5 1.5 0 0 0-1-.5C4.683 3 4 3.683 4 4.5V17a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5"
              ></path><line x1="10" y1="5" x2="8" y2="7"></line><line
                x1="2"
                y1="12"
                x2="22"
                y2="12"></line><line x1="7" y1="19" x2="7" y2="21"></line><line
                x1="17"
                y1="19"
                x2="17"
                y2="21"></line>
            </svg>

            <p class="text-lg font-bold dark:text-white">2</p>
          </div>

          <p class="text-sm text-ice-blue">Bathroom</p>
        </div>
        <!-- living area -->
        <div class="living-area flex flex-col">
          <div class="flex items-center gap-2">
            <svg
              class="w-4 aspect-square dark:text-white"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="--darkreader-inline-stroke: currentColor;"
              data-darkreader-inline-stroke=""
              ><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"
              ></path><path d="M21 19a2 2 0 0 1-2 2"></path><path
                d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path
                d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"
              ></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path
                d="M3 14v1"></path><path d="M21 14v1"></path>
            </svg>
            <p class="text-lg font-bold dark:text-white">175m²</p>
          </div>

          <p class="text-sm text-ice-blue">Living Area</p>
        </div>
      </div>

      <a href="" class="text-primary flex gap-1 group"
        >See more details <Icon
          name="lucide:arrow-right"
          class="w-[18px] aspect-square transition-all duration-300 text-primary group-hover:translate-x-1"
        />
      </a>
    </div>
    <div class="w-full md:w-1/2 relative pt-8 flex justify-center">
      <Picture
        class="h-full relative z-[2]"
        alt="Coco Beach® private lofts"
        src="/images/photo/building-clip-2.webp"
        widths={[410]}
        aspectRatio={789 / 828}
        sizes={`(min-width: 1024px) 410px,
        (min-width: 768px) 370px, 380px`}
      />

      <div
        class="absolute bottom-10 z-0 left-[42px] right-[42px] h-1/2 bg-[#eaeaff] dark:bg-[#121236]"
      >
      </div>
    </div>
  </div>
</section>
