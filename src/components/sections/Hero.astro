---
import { Image } from "@astrojs/image/components";
import PropertySearch from "@components/ui/PropertySearch.astro";
---

<section
  id="Hero"
  class="lg:h-[750px] 2xl:h-screen bg-semi-white-1 dark:bg-dark-blue relative flex lg:flex-row flex-col overflow-hidden"
>
  <div
    id="HeroContent"
    class="container flex flex-col gap-6 justify-center w-full h-full relative pt-48 md:pt-28 pb-20 md:pb-10 lg:py-0 px-5 lg:px-0 z-10"
  >
    <div class="max-w-[370px] flex flex-col gap-6">
      <h1
        class="font-TitilliumWeb dark:text-white font-light text-[32px] md:text-[48px] leading-9 text-center md:text-left md:leading-[54px] text-dark"
      >
        Find the house of your dreams.
      </h1>
      <p
        class="paragraph break-words text-center md:text-left text-lg md:text-xl"
      >
        We help you find the perfect space that will make you and your family
        happy.
      </p>
    </div>

    <PropertySearch />
  </div>

  <div
    class="hero-bg hidden md:block w-full lg:w-1/2 h-[492px] lg:h-full lg:absolute right-0 top-0 z-0"
  >
    <Image
      src={"/images/photo/hero/3.webp"}
      class="2xl:min-h-full 2xl:min-w-full"
      width={900}
      height={1000}
      alt="hero"
      format="webp"
    />
  </div>
</section>
