---
import PropertySearch from "@components/ui/PropertySearch.astro";
import LayoutSplit from "@layouts/LayoutSplit.astro";
---

<LayoutSplit title="Properties">
  <main id="Properties">
    <!-- PROPERTY SEARCH -->
    <section
      class="bg-semi-white-1 dark:bg-dark-purple-1 flex flex-col items-center relative p-12"
    >
      <div class="max-w-[740px]">
        <div class="pt-16 pb-6">
          <h1
            class="dark:text-white text-5xl font-TitilliumWeb text-dark font-light text-center mb-2"
          >
            Explore Properties
          </h1>
          <h2
            class="text-xl text-blue-gray dark:text-ice-blue leading-5 text-center"
          >
            We help you find the perfect space for you and your family.
          </h2>
        </div>

        <!-- search -->
        <PropertySearch />
      </div>
    </section>
  </main>
</LayoutSplit>
