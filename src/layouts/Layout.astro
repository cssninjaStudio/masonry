---
import { setDescription, setTitle } from "@utils/utils";
import { SEO } from "astro-seo";
import type { Props as IAstroSEO } from "astro-seo";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
interface Props extends IAstroSEO {}
const { title = "", description = "", ...props } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={setTitle(title)}
      description={setDescription(description)}
      {...props}
    />

    <GoogleFontsOptimizer
      url={[
        "https://fonts.googleapis.com/css2?family=Jost:wght@200;300;400;500;600;700&display=swap",
        "https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap",
      ]}
    />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <style is:global>
      html {
        height: 100%;
      }

      body {
        @apply h-full flex flex-col;
      }
    </style>
  </body>
</html>
