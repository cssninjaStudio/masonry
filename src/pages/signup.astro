---
import Logo from "@components/ui/Logo.astro";
import { APP } from "@data/config";
import Layout from "@layouts/Minimal.astro";
import { Icon } from "astro-icon";
---

<Layout title="Signup">
  <main
    id="Signup"
    class="signup-wrapper bg-semi-white-1 dark:bg-dark-blue relative"
  >
    <header class="signup-nav absolute top-0 left-0 z-[5] w-full px-3">
      <div class="container">
        <div
          class="signup-nav-inner flex justify-between items-center gap-3 min-h-[4.5rem]"
        >
          <a href="/" class="flex gap-4 items-center">
            <Logo class="h-10 aspect-square" />
            <p
              class="font-medium text-2xl font-TitilliumWeb text-dark dark:text-white"
            >
              {APP.name}
            </p>
          </a>
          <button
            class="darkToggle cursor-pointer relative w-9 aspect-square rounded-full border-gray-1 dark:border-dark-purple-3 border [&>svg]:text-yellow"
            @click="$store.app.toggleTheme()"
          >
            <!-- sun -->
            <Icon
              name="feather:sun"
              class="lightIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
              x-cloak
              :class="$store.app.isDark ? 'opacity-0 -translate-x-[45%] -translate-y-[150%]' : 'opacity-100  -translate-x-1/2 -translate-y-1/2' "
            />

            <!-- moon -->
            <Icon
              name="feather:moon"
              class="darkIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
              x-cloak
              :class="$store.app.isDark ? 'opacity-100  -translate-x-[45%] -translate-y-1/2' : 'opacity-0 -translate-x-[45%] -translate-y-[150%]' "
            />
          </button>
        </div>
      </div>
    </header>

    <section
      class="min-h-screen relative flex flex-col justify-between items-stretch"
    >
      <div class="flex items-center py-12 px-6 md:px-12 flex-grow">
        <div class="container">
          <div class="flex flex-col lg:flex-row lg:items-center">
            <div class="column p-3 lg:w-2/5 lg:ml-auto">
              <div class="signup-caption max-w-[420px] mb-6">
                <h1
                  class="dark:text-white text-[2.5rem] mb-2 font-light font-TitilliumWeb text-dark"
                >
                  Register
                </h1>
                <p class="text-blue-gray text-base">
                  Lorem ipsum dolor sit amet, consectetur adipiscing elit. Verum
                  hoc idem saepe faciamus.
                </p>
              </div>

              <form
                class="max-w-[420px] p-10 border border-gray-1 dark:border-dark-purple-6 bg-white dark:bg-dark-purple-2 flex flex-col gap-3"
              >
                <div class="field">
                  <label class="text-[.9rem] text-ice-blue">Email Address</label
                  >
                  <div class="control relative">
                    <input
                      type="text"
                      class="input w-full peer outline-none focus:outline-none p-3 pl-12 dark:bg-dark-purple-5 border dark:hover:border-dark-purple-8 text-blue-gray placeholder:text-gray-1 dark:text-ice-blue dark:placeholder:text-dark-purple-8 dark:border-dark-purple-3 transition-all duration-300 rounded h-12 text-base"
                      placeholder="Enter your email"
                    />
                    <div
                      class="form-icon peer-focus:[&>svg]:text-primary absolute left-0 top-0 grid place-items-center h-12 w-12"
                    >
                      <Icon
                        class="h-[18px] w-[18px] text-gray-3 dark:text-blue-gray stroke-[1.6px] transition-all duration-300"
                        name="feather:mail"
                      />
                    </div>
                  </div>
                </div>
                <div class="field">
                  <label class="text-[.9rem] text-ice-blue">Password</label>
                  <div class="control relative">
                    <input
                      type="password"
                      class="input w-full peer outline-none focus:outline-none p-3 pl-12 dark:bg-dark-purple-5 border dark:hover:border-dark-purple-8 text-blue-gray placeholder:text-gray-1 dark:text-ice-blue dark:placeholder:text-dark-purple-8 dark:border-dark-purple-3 transition-all duration-300 rounded h-12 text-base"
                      placeholder="Enter your password"
                    />
                    <div
                      class="form-icon peer-focus:[&>svg]:text-primary absolute left-0 top-0 grid place-items-center h-12 w-12"
                    >
                      <Icon
                        class="h-[18px] w-[18px] text-gray-3 dark:text-blue-gray stroke-[1.6px] transition-all duration-300"
                        name="feather:lock"
                      />
                    </div>
                  </div>
                </div>
                <div class="field">
                  <div class="signup-conditions flex items-center gap-2 py-2">
                    <label
                      class="inline-flex relative items-center cursor-pointer"
                    >
                      <input type="checkbox" class="appearance-none peer" />
                      <div
                        class="relative scale-75 inline-block w-[46px] h-[26px] bg-white dark:bg-dark-purple-1 border border-gray-1 dark:border-none peer-focus:outline-none after:border rounded-full peer-checked:bg-success transition-all duration-300 ease-linear before:content-[''] before:absolute before:w-[42px] before:h-[22px] before:dark:bg-dark-purple-1 before:rounded-full before:bg-white before:[transform:translate3d(2px,2px,0)_scale3d(1,1,1)] before:transition-all before:duration-[0.25s] before:ease-linear after:content-[''] after:absolute after:w-[22px] after:h-[22px] after:bg-white after:rounded-full after:[box-shadow:0_2px_2px_rgba(0,0,0,0.24)] after:[transform:translate3d(2px,2px,0)] peer-checked:before:[transform:translate3d(18px,2px,0)_scale3d(0,0,0)] peer-checked:after:[transform:translate3d(22px,2px,0)] after:transition-all after:duration-[0.2s] after:ease-in-out"
                      >
                      </div>
                    </label>
                    <span class="text-[.9rem] text-blue-gray"
                      >I agree to the <a class="text-primary"
                        >Terms Of Service</a
                      ></span
                    >
                  </div>
                </div>
                <div class="field">
                  <div class="buttons mt-4 mb-2">
                    <button
                      class="min-h-[48px] bg-primary rounded-[.2rem] font-medium text-[.9rem] w-full px-4 py-2 flex justify-center items-center text-white transition-all duration-300"
                    >
                      Sign Up</button
                    >
                  </div>

                  <div class="login-link text-center">
                    <a
                      href="/login"
                      class="hover:text-primary transition-colors duration-300 text-[.9rem] text-ice-blue"
                      >I already have an account</a
                    >
                  </div>
                </div>
              </form>
            </div>
            <div class="column hidden lg:block p-3 w-1/2">
              <img
                class="signup-illustration max-w-[420px] mx-auto"
                src="/images/illustrations/signup.svg"
                alt="Signup Illustration"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
