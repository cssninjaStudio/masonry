---
import { Image } from "@astrojs/image/components";
import SelectBox from "@components/ui/SelectBox.astro";
import Tab from "@components/ui/Tab.astro";
---

<section
  id="Hero"
  class="lg:h-[750px] 2xl:h-screen bg-semi-white dark:bg-dark-blue relative flex lg:flex-row flex-col overflow-hidden"
>
  <div
    id="HeroContent"
    class="container flex flex-col gap-6 justify-center w-full h-full relative pt-48 md:pt-28 pb-20 md:pb-10 lg:py-0 px-5 lg:px-0 z-10"
  >
    <div class="max-w-[370px] flex flex-col gap-6">
      <h1
        class="font-TitilliumWeb dark:text-white font-light text-[32px] md:text-[48px] leading-9 text-center md:text-left md:leading-[54px] text-dark"
      >
        Find the house of your dreams.
      </h1>
      <p
        class="paragraph break-words text-center md:text-left text-lg md:text-xl"
      >
        We help you find the perfect space that will make you and your family
        happy.
      </p>
    </div>

    <form action="">
      <!-- tabs -->
      <ul aria-label="Tabs" class="flex relative z-10">
        <li aria-label="Tab">
          <Tab label="Buy" selected={true} />
        </li>
        <li aria-label="Tab">
          <Tab label="Rent" />
        </li>
      </ul>

      <div
        class="p-3 bg-white dark:bg-dark-purple-2 relative -mt-px z-[5] flex justify-between flex-col md:flex-row gap-2 items-center lg:w-max border border-[#e3e3e3] dark:border-dark-purple-3"
      >
        <!-- select -->
        <SelectBox
          placeholder="Property Type"
          options={[
            "Private residence",
            "Private house",
            "Aparment",
            "Mansion",
          ]}
          id="PropertyType"
        />

        <!-- search input -->
        <div
          class="input-group flex items-center h-full md:border-l w-full md:w-max border-[#e3e3e3] dark:border-dark-purple-3 flex-row-reverse"
        >
          <input
            type="text"
            placeholder="Search by location"
            class="focus:outline-none h-[60px] w-full dark:bg-dark-purple-2"
          />

          <!-- icon -->
          <div
            class="h-[60px] aspect-square text-[#93A5BE] flex justify-center items-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-[18px] h-[18px]"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
        </div>

        <button
          type="submit"
          class="h-[60px] min-w-[150px] w-full md:w-max font-medium text-lg px-4 py-2 rounded flex justify-center items-center transition-all duration-300 bg-primary text-white hover:[box-shadow:rgba(46,49,255,0.42)_0px_14px_26px_-12px,rgba(0,0,0,0.12)_0px_4px_23px_0px,rgba(46,49,255,0.2)_0px_8px_10px_-5px]"
          >Search</button
        >
      </div>

      <!-- only new -->
      <div class="text-[#93A5BE] mt-6">
        <label
          for="new-properties"
          class="inline-flex relative items-center cursor-pointer"
        >
          <input
            id="new-properties"
            type="checkbox"
            class="appearance-none peer"
          />
          <div
            class="relative inline-block w-[46px] h-[26px] bg-white dark:bg-dark-purple-1 border border-[#e3e3e3] dark:border-dark-purple-2 peer-focus:outline-none after:border rounded-full peer-checked:bg-primary transition-all duration-300 ease-linear before:content-[''] before:absolute before:w-[42px] before:h-[22px] before:dark:bg-dark-purple-1 before:rounded-full before:bg-white before:[transform:translate3d(2px,2px,0)_scale3d(1,1,1)] before:transition-all before:duration-[0.25s] before:ease-linear after:content-[''] after:absolute after:w-[22px] after:h-[22px] after:bg-white after:rounded-full after:[box-shadow:0_2px_2px_rgba(0,0,0,0.24)] after:[transform:translate3d(2px,2px,0)] peer-checked:before:[transform:translate3d(18px,2px,0)_scale3d(0,0,0)] peer-checked:after:[transform:translate3d(22px,2px,0)] after:transition-all after:duration-[0.2s] after:ease-in-out"
          >
          </div>
          <span class="ml-3 text-sm font-medium text-ice-blue"
            >Only include new properties</span
          >
        </label>
      </div>

      <!-- <Switch /> -->
    </form>
  </div>

  <div
    class="hero-bg hidden md:block w-full lg:w-1/2 h-[492px] lg:h-full lg:absolute right-0 top-0 z-0"
  >
    <Image
      src={"/images/photo/hero/3.webp"}
      class="2xl:min-h-full 2xl:min-w-full"
      width={900}
      height={1000}
      alt="hero"
      format="webp"
    />
  </div>
</section>
