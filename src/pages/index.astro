---
import Hero from "@components/sections/Hero.astro";
import Popular from "@components/sections/Popular.astro";
import { property } from "@data/property";
import Layout from "@layouts/Layout.astro";
import PrivateLoft from "@components/sections/PrivateLoft.astro";
import WhatWeDo from "@components/sections/WhatWeDo.astro";
import Partnership from "@components/sections/Partnership.astro";
import Ranking from "@components/sections/Ranking.astro";
import Talented from "@components/sections/Talented.astro";
import Testimonials from "@components/sections/Testimonials.astro";
---

<Layout>
  <main id="Home">
    <!-- HERO -->
    <Hero />

    <!-- POPULAR 3-->

    <Popular properties={property.slice(0, 3)} />

    <!-- COCO BEACH -->

    <PrivateLoft />

    <!-- WHAT WE CAN DO -->
    <WhatWeDo />

    <!-- POPULAR 6 -->
    <Popular properties={property.slice(3)} />

    <!-- TALENTED -->
    <Talented />

    <!-- RANKING -->
    <Ranking />

    <!-- PARTNERSHIP -->
    <Partnership />

    <!-- WHAT THEY SAY -->
    <Testimonials />

    <!-- LOGOS -->

    <section class="px-5 lg:px-0 py-8 lg:py-12">
      <!-- logos -->

      <div class="max-w-[600px] mx-auto grid grid-cols-3 lg:grid-cols-4">
        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/gutwork.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/kromo.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/tribe.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/hewitt.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>
        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/proactive.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/vonmo.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/infinite.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/natchpay.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>
        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/asuna.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/bobcot.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/phasekit.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/grubspot.svg"
            class="max-w-[80px] lg:max-w-[110px]"
            alt="Customer Logo"
          />
        </div>
      </div>
    </section>

    <!-- ENGAGE/CTA-->
    <section class="py-12">
      <div
        class="max-w-[780px] relative mx-auto py-20 px-8 bg-cover bg-no-repeat"
        style="background-image: url('/images/photo/cta.webp');"
      >
        <div
          class="relative z-[2] w-full h-full flex flex-col justify-center items-center text-white"
        >
          <h2
            class="max-w-[460px] text-[32px] leading-9 font-TitilliumWeb text-center"
          >
            Engage with our company and invest in our projects
          </h2>
          <div
            class="flex flex-col w-full md:w-max md:flex-row items-center mt-6 gap-2 mb-2"
          >
            <button
              class="hover:bg-white w-full md:w-max hover:text-primary transition-all px-4 py-2 min-w-[130px] min-h-[48px] rounded border-2 border-white"
              >Invest Now</button
            >
            <button
              class="hover:bg-white w-full md:w-max hover:text-primary transition-all px-4 py-2 min-w-[130px] min-h-[48px] rounded border-2 border-white"
              >Learn More</button
            >
          </div>
        </div>
        <!-- overlay -->
        <div class="overlay absolute inset-0 bg-primary/80 z-0"></div>
      </div>
    </section>
  </main>
</Layout>

<style></style>
