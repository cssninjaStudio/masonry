---
import { APP } from "@data/config";
import { Icon } from "astro-icon";
import Logo from "./ui/Logo.astro";
---

<div
  id="HeaderWrapper"
  data-scrolled="false"
  class="fixed top-0 left-0 w-full z-[1000]"
>
  <header
    class="container flex justify-between bg-white lg:transparent px-3 md:px-0"
  >
    <div class="flex items-center gap-3 py-3">
      <a href="/" class="flex gap-4 items-center">
        <Logo class="h-10 aspect-square" />
        <p class="font-medium text-2xl font-TitilliumWeb text-dark">
          {APP.name}
        </p>
      </a>

      <ul id="LeftLinks" class="hidden lg:flex items-center">
        <li>
          <a
            href="/about"
            class="py-2 px-3 leading-6 text-base text-blue-gray flex items-center gap-1"
            >Properties <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="/about"
            class="py-2 px-3 leading-6 text-base text-blue-gray flex items-center gap-1"
            >Rentals <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="/about"
            class="py-2 px-3 leading-6 text-base text-blue-gray block">About</a
          >
        </li>
      </ul>
    </div>

    <ul id="RightLinks" class="hidden lg:flex items-center gap-6">
      <li class="h-max flex justify-center items-center">
        <a href="/" class="py-2 leading-6 text-base text-white">Sign In</a>
      </li>

      <!-- search -->
      <li class="h-max pl-6 flex justify-center items-center">
        <a href="" class="inline-block text-base text-white">
          <svg
            class="w-4"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="--darkreader-inline-stroke: currentColor;"
            data-darkreader-inline-stroke=""
            ><circle cx="11" cy="11" r="8"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line>
          </svg>
        </a>
      </li>

      <!-- whishlist -->
      <li class="h-max flex justify-center items-center">
        <a href="/about" class="inline-block text-base text-white">
          <Icon name="lucide:heart" class="w-4 aspect-auto" />
        </a>
      </li>

      <!-- dark/light mode switch -->
      <li class="h-max flex justify-center items-center">
        <button
          id="darkToggle"
          class="group relative w-9 aspect-square rounded-full"
        >
          <!-- sun -->
          <Icon
            name="feather:sun"
            class="w-4 text-white aspect-auto absolute opacity-100 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
          />

          <!-- moon -->
          <Icon
            name="feather:moon"
            class="w-4 text-white aspect-auto absolute -top-full left-1/2 opacity-0"
          />
        </button>
      </li>

      <!-- register -->
      <li class="h-max">
        <a
          href="/register"
          class="h-[46px] min-w-[120px] font-medium text-sm leading-6 px-3.5 py-1.5 flex justify-center items-center transition-all duration-300 rounded bg-primary text-white"
          >Register</a
        >
      </li>
    </ul>

    <button class="lg:hidden"> </button>
  </header>
</div>

<style>
  [data-scrolled="true"] {
    @apply bg-white;
  }
  [data-scrolled="true"] {
    @apply border-b border-[#e3e3e3];
  }
  [data-scrolled="true"] {
    @apply [box-shadow:0_0_10px_0_rgba(0,0,0,.08)] border-b border-[#e3e3e3];
  }
  [data-scrolled="true"] header ul#RightLinks li:nth-child(2) {
    @apply border-l border-[#e3e3e3] h-full;
  }

  [data-scrolled="true"] header ul#RightLinks li:first-child a,
  [data-scrolled="true"] header ul#RightLinks li svg {
    @apply text-dark;
  }
  [data-scrolled="true"] header ul#RightLinks li button#darkToggle {
    @apply border border-blue-gray;
  }
  [data-scrolled="true"] header ul#RightLinks li button svg {
    @apply text-[#ffd770];
  }
  [data-scrolled="true"] header ul#RightLinks li:last-child a {
    @apply [box-shadow:rgba(46,49,255,0.42)_0px_14px_26px_-12px,rgba(0,0,0,0.12)_0px_4px_23px_0px,rgba(46,49,255,0.2)_0px_8px_10px_-5px];
  }
</style>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const headWrapper = document.querySelector("#HeaderWrapper");
    const targets = [
      document.querySelector("#HeroContent h1"),
      ...document.querySelectorAll("div"),
    ];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const scrollThreshold = 40;
            if (
              document.documentElement.scrollTop > scrollThreshold ||
              document.body.scrollTop > scrollThreshold
            ) {
              headWrapper.dataset.scrolled = "true";
            } else {
              headWrapper.dataset.scrolled = "false";
            }
          }
        });
      },
      { rootMargin: "-300px" }
    );
    targets.forEach((target) => {
      observer.observe(target);
    });
  });
</script>
