            <!-- map -->
            <iframe
              class="min-h-[220px] w-full"
              marginheight="0"
              marginwidth="0"
              title="map"
              scrolling="no"
              src="https://maps.google.com/maps?width=100%&height=100%&hl=en&q=Los%20Angeles+(Css%20Ninja)&center=-117.1627728,32.7174202&ie=UTF8&t=&z=14&iwloc=B&output=embed&zoom=12"
              style="filter: grayscale(1) contrast(1.2) opacity(0.4)"
