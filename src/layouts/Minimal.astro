---
import { setDescription, setTitle } from "@utils/utils";
import { SEO } from "astro-seo";
import type { Props as IAstroSEO } from "astro-seo";
import Navbar from "@components/Navbar.astro";
import Footer from "@components/Footer.astro";
import { GoogleFontsOptimizer } from "astro-google-fonts-optimizer";
import ScrollTop from "@components/ui/ScrollTop.astro";
import "@/styles/global.scss";
import { APP } from "@data/config";
import Logo from "@components/ui/Logo.astro";
import { Icon } from "astro-icon";

interface Props extends IAstroSEO {}
const { title = "", description = "", ...props } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/images/logo/logo.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={setTitle(title)}
      description={setDescription(description)}
      {...props}
    />

    <GoogleFontsOptimizer
      url={[
        "https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,300;8..144,400;8..144,500;8..144,600",
        "https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap",
      ]}
    />

    <slot name="head" />
  </head>
  <body x-data :class="{'dark':$store.app.isDark}">
    <div id="Top"></div>

    <header class="fixed top-0 left-0 w-full z-50 px-3 lg:px-0">
      <div
        class="container flex justify-between items-center gap-3 min-h-[70px]"
      >
        <a href="/" class="flex gap-4 items-center py-2">
          <Logo class="h-10 aspect-square" />
          <p
            class="font-medium text-2xl font-TitilliumWeb text-dark dark:text-white"
          >
            {APP.name}
          </p>
        </a>
        <button
          class="darkToggle relative w-9 aspect-square rounded-full border-gray-1 dark:border-dark-purple-3 border [&>svg]:text-yellow"
          @click="$store.app.toggleTheme()"
        >
          <!-- sun -->
          <Icon
            name="feather:sun"
            class="lightIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
            x-cloak
            :class="$store.app.isDark ? 'opacity-0 -translate-x-[45%] -translate-y-[150%]' : 'opacity-100  -translate-x-1/2 -translate-y-1/2' "
          />

          <!-- moon -->
          <Icon
            name="feather:moon"
            class="darkIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
            x-cloak
            :class="$store.app.isDark ? 'opacity-100  -translate-x-[45%] -translate-y-1/2' : 'opacity-0 -translate-x-[45%] -translate-y-[150%]' "
          />
        </button>
      </div>
    </header>

    <slot />
    <ScrollTop />

    <script>
      import { MASONRY_THEME } from "@/constants";

      document.addEventListener("alpine:init", () => {
        Alpine.store("app", {
          init() {
            this.isDark =
              MASONRY_THEME in localStorage
                ? localStorage.getItem(MASONRY_THEME) === "dark"
                : window.matchMedia("(prefers-color-scheme: dark)").matches;
          },
          toggleTheme() {
            this.isDark = !this.isDark;
            localStorage.setItem(MASONRY_THEME, this.isDark ? "dark" : "light");
          },
          isDark: false,
          isLoggedIn: false,
        });
      });
    </script>
  </body>
</html>
