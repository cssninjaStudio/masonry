---
import { Picture } from "@astrojs/image/components";
import { Icon } from "astro-icon";
import MegaMenuLink from "./MegaMenuLink.astro";
---

<section
  id="MegaMenuWrapper"
  class="absolute top-0 lg:top-full w-full transition-all bg-white dark:bg-dark-purple-2 grid duration-300"
  :class="megamenuOpened ? 'translate-y-0  opacity-100 pointer-events-auto' : 'translate-y-2.5 opacity-0 pointer-events-none' "
  x-cloak
>
  <div
    id="propertiesMega"
    x-show="openedMegamenu === 'megamenu-1'"
    class="mega w-full py-[60px] relative"
  >
    <button
      class="close-button absolute top-2.5 right-2.5 md:top-6 md:right-6 h-10 w-10 lg:hidden grid place-content-center"
      @click="megamenuOpened = !megamenuOpened"
    >
      <Icon class="h-7 w-7 dark:text-white" name="lucide:arrow-left" />
    </button>
    <ul class="container flex md:flex-row flex-col gap-5">
      <li class="md:w-[35%]">
        <div class="megamenu-block px-12 md:px-0 md:ml-12 lg:ml-0">
          <div class="flex flex-col lg:flex-row gap-4">
            <div>
              <Icon
                name="ph:buildings-duotone"
                class="w-10 aspect-square text-primary"
              />
            </div>

            <div class="flex flex-col">
              <h3
                class="font-TitilliumWeb font-semibold text-xl dark:text-white text-dark mb-3"
              >
                Properties
              </h3>
              <p class="mb-4 text-ice-blue text-base">
                Masonry makes it easy to browse homes. When you’re ready, you
                can also connect with a local agent to explore financing
                solutions
              </p>
              <a href="/properties" class="flex text-primary">
                <span>Explore all properties</span>
                <Icon name="lucide:arrow-right" class="w-5 aspect-square" />
              </a>
            </div>
          </div>
        </div>
      </li>
      <li class="md:w-[15%]">
        <div class="megamenu-block px-12 md:px-0">
          <h4
            class="text-sm font-TitilliumWeb font-semibold text-dark dark:text-white uppercase"
          >
            Categories
          </h4>
          <ul class="flex flex-col gap-2 mt-3">
            <li>
              <MegaMenuLink title="Residences" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Apartments" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Houses" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Mansions" href="#" />
            </li>
          </ul>
        </div>
      </li>
      <li class="md:w-1/2">
        <div class="megamenu-block px-8 md:px-12 lg:px-0 flex gap-5">
          <a href="#" class="showcase-item">
            <Picture
              class="lg:h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/1.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 100%`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Barnaby Tower
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
          <a href="#" class="showcase-item">
            <Picture
              class="lg:h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/2.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 100%`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  High Hils
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
        </div>
      </li>
    </ul>
  </div>

  <div
    id="rentalsMega"
    x-show="openedMegamenu === 'megamenu-2'"
    class="mega w-full py-[60px] relative"
  >
    <button
      class="close-button absolute top-2.5 right-2.5 md:top-6 md:right-6 h-10 w-10 lg:hidden grid place-content-center"
      @click="megamenuOpened = !megamenuOpened"
    >
      <Icon class="h-7 w-7 dark:text-white" name="lucide:arrow-left" />
    </button>
    <ul class="container flex md:flex-row flex-col gap-5">
      <li class="md:w-[35%]">
        <div class="megamenu-block px-12 md:px-0 md:ml-12 lg:ml-0">
          <div class="flex flex-col lg:flex-row gap-4">
            <div>
              <Icon
                name="ph:house-duotone"
                class="w-10 aspect-square text-primary"
              />
            </div>

            <div class="flex flex-col">
              <h3
                class="font-TitilliumWeb font-semibold text-xl dark:text-white text-dark mb-3"
              >
                Rentals
              </h3>
              <p class="mb-4 text-ice-blue text-base">
                Masonry makes it easy to browse homes. When you’re ready, you
                can also connect with a local agent to explore financing
                solutions
              </p>
              <a href="/properties" class="flex text-primary">
                <span>Explore all properties</span>
                <Icon name="lucide:arrow-right" class="w-5 aspect-square" />
              </a>
            </div>
          </div>
        </div>
      </li>
      <li class="md:w-[15%]">
        <div class="megamenu-block px-12 md:px-0">
          <h4
            class="text-sm font-TitilliumWeb font-semibold text-dark dark:text-white uppercase"
          >
            Categories
          </h4>
          <ul class="flex flex-col gap-2 mt-3">
            <li>
              <MegaMenuLink title="Residences" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Apartments" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Houses" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Mansions" href="#" />
            </li>
          </ul>
        </div>
      </li>
      <li class="md:w-1/2">
        <div class="megamenu-block px-8 md:px-12 lg:px-0 flex gap-5">
          <a href="#" class="showcase-item">
            <Picture
              class="lg:h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/3.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 100%`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Cozy Beach House
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
          <a href="#" class="showcase-item">
            <Picture
              class="lg:h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/4.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 100%`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Stanislas tower
                </h5>
                <p class="text-ice-blue text-sm">Luxury Apartments</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>
