              <div class="property-info-line flex items-center justify-between">
                <p class="info-label text-ice-blue">Status</p>
                <p class="info-value dark:text-semi-white-3 text-dark">
                  Available
                </p>
              </div>

              <div class="property-info-line flex items-center justify-between">
                <p class="info-label text-ice-blue">Credit</p>
                <p class="info-value dark:text-semi-white-3 text-dark">Yes</p>
              </div>

              <div class="property-info-line flex items-center justify-between">
                <p class="info-label text-ice-blue">Discount</p>
                <p class="info-value dark:text-semi-white-3 text-dark">5%</p>
              </div>
            </div>

            <button
              class="bg-primary mb-6 font-medium text-base text-white rounded-[.2rem] h-[44px] transition-all duration-300 py-2 px-4 flex justify-center cursor-pointer w-full hover:shadow-xl"
