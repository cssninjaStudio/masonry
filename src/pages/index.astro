---
import Hero from "@components/sections/Hero.astro";
import Popular from "@components/sections/Popular.astro";
import { property } from "@data/property";
import Layout from "@layouts/Layout.astro";
import PrivateLoft from "@components/sections/PrivateLoft.astro";
import WhatWeDo from "@components/sections/WhatWeDo.astro";
import Partnership from "@components/sections/Partnership.astro";
import Ranking from "@components/sections/Ranking.astro";
import Talented from "@components/sections/Talented.astro";
import Testimonials from "@components/sections/Testimonials.astro";
---

<Layout>
  <main id="Home">
    <!-- HERO -->
    <Hero />

    <!-- POPULAR 3-->

    <Popular properties={property.slice(0, 3)} />

    <!-- COCO BEACH -->

    <PrivateLoft />

    <!-- WHAT WE CAN DO -->
    <WhatWeDo />

    <!-- POPULAR 6 -->
    <Popular properties={property.slice(3)} />

    <!-- TALENTED -->
    <Talented />

    <!-- RANKING -->
    <Ranking />

    <!-- PARTNERSHIP -->
    <Partnership />

    <!-- WHAT THEY SAY -->
    <Testimonials />

    <!-- LOGOS -->

    <section class="py-12">
      <!-- logos -->

      <div class="max-w-[600px] mx-auto grid grid-cols-4">
        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/gutwork.svg"
            class="max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
          <img
            src="/images/logos/kromo.svg"
            class="max-w-[110px]"
            alt="Customer Logo"
          />
        </div>

        <!-- logo -->
        <div class="flex justify-center items-center">
