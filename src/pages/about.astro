---
import { Image } from "@astrojs/image/components";
import EngageCTA from "@components/sections/EngageCTA.astro";
import IconMatrix from "@components/sections/IconMatrix.astro";
import Logos from "@components/sections/Logos.astro";
import PropertyGrid from "@components/sections/PropertyGrid.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import LayoutSplit from "@layouts/LayoutSplit.astro";
import { Icon } from "astro-icon";
---

<LayoutSplit title="About">
  <main id="About">
    <!-- HERO -->
    <section
      class="min-h-screen dark:bg-dark-blue bg-semi-white-1 relative flex flex-col justify-between items-stretch"
    >
      <div
        class="flex items-center px-6 py-12 md:px-12 flex-grow flex-shrink-0"
      >
        <div class="container">
          <div class="flex flex-col md:flex-row md:items-center">
            <div class="md:w-1/3 md:p-3">
              <div class="hero-caption">
                <h1
                  class="dark:text-semi-white-2 text-center md:text-left text-[2rem] font-light leading-none md:text-5xl mb-6 font-TitilliumWeb text-dark"
                >
                  Find the house of your dreams.
                </h1>
                <h2
                  class="mb-6 text-xl text-blue-gray text-center md:text-left dark:text-ice-blue leading-[1.25]"
                >
                  We help you find the perfect space that will make you and your
                  family happy.
                </h2>

                <!-- buttons -->
                <div
                  class="flex justify-center md:justify-start items-center gap-2"
                >
                  <a
                    href="#start-section"
                    class="h-[44px] transition-all duration-300 px-4 py-2 text-center whitespace-nowrap flex justify-center items-center mb-2 bg-primary text-white text-[.9rem] font-medium rounded-[.2rem] min-w-[8rem]"
                    >Learn more</a
                  >
                  <a
                    href="#quote-section"
                    class="h-[44px] border border-gray-1 dark:border-dark-purple-5 text-dark dark:text-white rounded-[.2rem] bg-white dark:bg-dark-purple-2 transition-all duration-300 px-4 py-2 text-center whitespace-nowrap flex justify-center items-center mb-2 is-solid min-w-[8rem]"
                    >Get a quote</a
                  >
                </div>
              </div>
            </div>
            <div class="md:p-3 md:w-3/5 md:ml-[8.3%]">
              <figure class="block relative">
                <img
                  src="/images/illustrations/hero-next.svg"
                  alt="Hero image"
                />
              </figure>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-foot flex-grow-0 flex-shrink-0">
        <div class="container">
          <div
            class="flex items-stretch justify-between overflow-hidden overflow-x-auto whitespace-nowrap"
          >
            <ul class="flex justify-center items-center list-none gap-5 w-full">
              <li>
                <img
                  class="max-w-[120px] min-h-[20px] invert-[1]"
                  src="/images/logos/vonmo.svg"
                  alt="Customer logo"
                />
              </li>
              <li>
                <img
                  class="max-w-[120px] min-h-[20px] invert-[1]"
                  src="/images/logos/asuna.svg"
                  alt="Customer logo"
                />
              </li>
              <li>
                <img
                  class="max-w-[120px] min-h-[20px] invert-[1]"
                  src="/images/logos/bobcot.svg"
                  alt="Customer logo"
                />
              </li>
              <li>
                <img
                  class="max-w-[120px] min-h-[20px] invert-[1]"
                  src="/images/logos/infinite.svg"
                  alt="Customer logo"
                />
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- FOUNDER -->
    <section class="py-12 md:pt-36 dark:bg-dark-purple-1 px-6">
      <div
        class="container pb-16 mb-4 border-b dark:border-[#26264b] border-gray-1"
      >
        <div class="flex flex-col md:flex-row items-center">
          <div class="p-3 md:ml-[8.3%] md:w-2/5">
            <span
              class="grid place-items-center rounded text-xs leading-[2.5] px-3 text-primary mb-2 border border-primary w-max uppercase h-10"
              >ABOUT US</span
            >
            <h3
              class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-semi-white-2 leading-[1.125]"
            >
              Joshua Stevens, our Founder
            </h3>
            <p class="py-2 max-w-[27.5rem] text-blue-gray">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Illud non
              continuo, ut aeque incontentae. Duo Reges: constructio interrete.
              Si qua in iis corrigere voluit.
            </p>

            <div class="property-details grid grid-cols-3 py-8">
              <div class="property-detail">
                <div
                  class="detail-head flex gap-2 items-center text-dark dark:text-semi-white-2"
                >
                  <Icon class="h-5 aspect-auto" name="lucide:building" />
                  <span class="font-bold text-xl">30K</span>
                </div>
                <div class="detail-content">
                  <p class="text-base text-ice-blue">Housings sold</p>
                </div>
              </div>
              <div class="property-detail">
                <div
                  class="detail-head flex gap-2 items-center text-dark dark:text-semi-white-2"
                >
                  <Icon class="h-5 aspect-auto" name="lucide:crown" />
                  <span class="font-bold text-xl">50K</span>
                </div>
                <div class="detail-content">
                  <p class="text-base text-ice-blue">Happy clients</p>
                </div>
              </div>
              <div class="property-detail">
                <div
                  class="detail-head flex gap-2 items-center text-dark dark:text-semi-white-2"
                >
                  <svg
                    class="h-5 aspect-auto"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    style="--darkreader-inline-stroke: currentColor;"
                    data-darkreader-inline-stroke=""
                    ><path
                      d="M6 22V4c0-.27 0-.55.07-.82a1.477 1.477 0 0 1 1.1-1.11C7.46 2 8.73 2 9 2h7c.27 0 .55 0 .82.07a1.477 1.477 0 0 1 1.11 1.1c.07.28.07.56.07.83v18H6Z"
                    ></path><path
                      d="M2 14v6c0 1.1.9 2 2 2h2V12H4c-.27 0-.55 0-.82.07-.27.07-.52.2-.72.4-.19.19-.32.44-.39.71A3.4 3.4 0 0 0 2 14Z"
                    ></path><path
                      d="M20.82 9.07A3.4 3.4 0 0 0 20 9h-2v13h2a2 2 0 0 0 2-2v-9c0-.28 0-.55-.07-.82-.07-.27-.2-.52-.4-.72-.19-.19-.44-.32-.71-.39Z"
                    ></path><path d="M10 6h4"></path><path d="M10 10h4"
                    ></path><path d="M10 14h4"></path><path d="M10 18h4"
                    ></path></svg
                  >

                  <span class="font-bold text-xl">247</span>
                </div>
                <div class="detail-content">
                  <p class="text-base text-ice-blue">Live projects</p>
                </div>
              </div>
            </div>
          </div>

          <div class="p-3 md:w-1/2">
            <div
              class="relative flex flex-col justify-end max-w-[480px] min-h-[380px] md:min-h-[450px] -mt-8 mx-auto"
            >
              <Image
                height={676}
                width={500}
                class="block absolute bottom-0 left-1/2 -translate-x-1/2 max-w-[280px] md:max-w-[320px] z-[2]"
                src="/images/photo/person-clip.webp"
                alt=""
              />

              <div class="relative w-full pt-[58%] opacity-20 bg-yellow"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BOXES SECTION -->
    <section class="boxes-section dark:bg-dark-purple-1 px-6 py-12 pb-[60px]">
      <div class="container flex flex-col md:flex-row items-center gap-6">
        <div class="w-full md:w-1/3">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-semi-white-2 leading-[1.125] mb-6"
