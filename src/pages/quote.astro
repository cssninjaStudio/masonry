                        <img
                          class="light-image-block max-w-[3rem] grayscale opacity-80 transition-all duration-300 dark:hidden"
                          src="/images/icons/f13.svg"
                          alt=""
                        />
                        <img
                          class="dark-image-block max-w-[3rem] grayscale opacity-80 transition-all duration-300 hidden dark:block"
                          src="/images/icons/f13-dark.svg"
                          alt=""
                        />
                        <div class="meta leading-[1.1] text-left">
