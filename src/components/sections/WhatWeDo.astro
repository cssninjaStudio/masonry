---
import { Icon } from "astro-icon";
---

<section class="py-12 px-6 lg:p-12 dark:bg-dark-purple-1">
  <div class="container">
    <h3 class="title-2">What we can do to help you</h3>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 py-8 border-b border-blue-gray/20"
    >
      <!-- 1 -->
      <div
        class="p-9 flex flex-col cursor-pointer group hover:[box-shadow:rgba(0,_0,_0,_0.12)_-1px_3px_10px_0px] hover:border dark:border-dark-purple-6 border-gray-1 bg-white dark:bg-dark-purple-1 dark:hover:bg-dark-purple-3 transition-all"
        class="p-9 flex flex-col cursor-pointer group bg-white dark:bg-dark-purple-1 dark:hover:bg-dark-purple-3 transition-all"
      >
        <!-- icon -->
        <span
          class="w-14 aspect-square grid place-items-center group-hover:[&>svg]:scale-75 group-hover:[&>span]:scale-100 relative group"
        >
          <Icon
            name="ph:handshake-duotone"
            class="w-10 aspect-square text-primary transition-all duration-200 relative z-10"
          />

          <span
            class="bg-[#eff0ff] dark:bg-primary/10 absolute inset-0 z-0 scale-0 transition-all duration-300 rounded-full"
          ></span>
        </span>
        <h4
          class="text-xl dark:text-white font-TitilliumWeb mt-6 mb-2 text-dark font-semibold"
        >
          Selling
        </h4>
        <p class="mb-6 text-sm leading-6 text-blue-gray">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Summum ením
          bonum exposuit vacuitatem.
        </p>
        <a href="" class="text-primary text-sm font-medium flex gap-1 group"
          >Learn more <Icon
            name="lucide:arrow-right"
            class="w-[18px] aspect-square transition-all duration-300 text-primary group-hover:translate-x-1"
          />
        </a>
