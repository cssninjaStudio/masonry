---
import { projects } from "@data/property";
import { Icon } from "astro-icon";
import PolkaDots from "../PolkaDots.astro";
---

<div class="projects-carousel relative">
  <!-- Polka dots -->
  <div class="absolute top-3 -left-11"><PolkaDots /></div>
  <div class="absolute -bottom-10 -right-11"><PolkaDots /></div>

  <div
    x-data="{swiper:null}"
    x-init="this.swiper = initProjectsSwiper(this.$refs.container)"
    class="carousel-container relative z-[2]"
  >
    <div class="carousel-controls flex justify-end mb-6">
      <button
        @click="swiper.slidePrev()"
        class="flex justify-center items-center outline-none h-8 aspect-square text-lg rounded-full cursor-pointer transition-colors duration-300 bg-none hover:bg-ice-blue hover:dark:bg-dark-purple-3 group"
      >
        <Icon
          class="text-ice-blue group-hover:text-dark dark:group-hover:text-white h-6 aspect-auto"
          name="lucide:arrow-left"
        />
      </button>

      <button
        @click="swiper.slideNext()"
        class="flex justify-center items-center outline-none h-8 aspect-square text-lg rounded-full cursor-pointer transition-colors duration-300 bg-none hover:bg-ice-blue hover:dark:bg-dark-purple-3 group"
      >
        <Icon
          class="text-ice-blue group-hover:text-dark dark:group-hover:text-white h-6 aspect-auto"
          name="lucide:arrow-right"
        />
      </button>
    </div>
    <div class="swiper-container" x-ref="container">
      <div class="swiper-wrapper">
        <!-- Slides -->
        {
          projects.map((project) => (
            <div class="swiper-slide">
              <a class="slide-inner">
                <div class="slide-content relative">
                  <img
                    class="h-48 w-full object-cover"
                    src={project.image}
                    alt="Slide image"
                  />
                  <div class="slide-overlay-content hover:opacity-100 absolute top-0 h-full w-full opacity-0 transition-opacity duration-300 left-0">
                    <div class="slide-overlay absolute top-0 h-full w-full bg-gradient-to-t from-[#161616] z-0 left-0">
                      <div class="slide-icon absolute top-6 left-6 flex items-center justify-center h-10 aspect-square rounded-full bg-dark-purple-2">
                        <img
                          src={project.flag}
                          class="h-8 aspect-square rounded-full"
                          alt="Slide icon"
                        />
                      </div>
                      <div class="overlay-content relative h-full w-full flex flex-col justify-end">
                        <div class="text-content p-6">
                          <h3 class="font-TitilliumWeb dark:text-white font-light  text-dark text-xl ">
                            {project.title}
                          </h3>
                          <p class="opacity-70 text-[#fcfcfc] text-base">
                            {project.location}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import Swiper from "swiper";
  function initProjectsSwiper(element) {
    return new Swiper(element, {
      loop: true,
      autoplay: {
        delay: 5000,
      },
      slidesPerView: 4,
      spaceBetween: 20,
      pagination: {
        el: ".carousel-pagination",
        type: "bullets",
      },
      breakpoints: {
        340: {
          slidesPerView: 1.5,
          spaceBetween: 20,
        },
        768: {
          slidesPerView: 3,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 4,
          spaceBetween: 20,
        },
      },
    });
  }
</script>
