---
import { Icon } from "astro-icon";
import Logo from "./ui/Logo.astro";
---

<footer class="mt-auto px-5 dark:bg-dark-purple-2">
  <div class="container pt-8 lg:pt-24 pb-8">
    <div class="grid grid-cols-1 gap-10 lg:gap-0 md:grid-cols-6">
      <div class="md:col-span-2 pr-[5%] lg:pr-[98px]">
        <a href="/" class="flex gap-4 items-center">
          <Logo class="h-8 aspect-square" />
        </a>
        <p class="text-sm text-blue-gray mt-4">
          We are a Real Estate company. We bring freshness of modern design into
          your house and at your work.
        </p>

        <!-- socials -->
        <div class="socials mt-4 flex gap-5 items-center">
          <a href="#">
            <Icon
              name="fa:instagram"
              class="w-3.5 aspect-square text-blue-gray"
            />
          </a>
          <a href="#">
            <Icon
              name="fa:facebook"
              class="w-3.5 aspect-square text-blue-gray"
            />
          </a>
          <a href="#">
            <Icon
              name="fa:pinterest"
              class="w-3.5 aspect-square text-blue-gray"
            />
          </a>
          <a href="#">
            <Icon name="fa:medium" class="w-3.5 aspect-square text-blue-gray" />
          </a>
        </div>
      </div>
      <!-- company links -->
      <div class="">
        <h4
          class="font-TitilliumWeb text-dark font-semibold text-xl dark:text-white"
        >
          Company
        </h4>
        <ul class="footer-menu mt-4 flex flex-col gap-2">
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Services</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >How we work</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Get a quote</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Case studies</a
            >
          </li>
        </ul>
      </div>
      <!-- more links -->
      <div class="">
        <h4
          class="font-TitilliumWeb text-dark font-semibold text-xl dark:text-white"
        >
          More
        </h4>
        <ul class="footer-menu mt-4 flex flex-col gap-2">
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >About</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Company</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Terms Of Service</a
            >
          </li>
          <li>
            <a
              href="#"
              class="footer-link text-sm text-blue-gray hover:text-primary transition-all"
              >Assistance</a
            >
          </li>
        </ul>
      </div>
      <!-- find us -->
      <div class="md:col-span-2">
        <h4
          class="font-TitilliumWeb text-dark font-semibold text-xl dark:text-white"
        >
          Find Us
        </h4>
        <ul class="footer-menu mt-4 flex flex-col gap-2">
          <li class="text-sm text-blue-gray">55 San Joaquin Ave. 90893</li>
          <li class="text-sm text-blue-gray">San Francisco, CA.</li>
          <li class="text-sm text-blue-gray">hello@masonry.co</li>
        </ul>
      </div>
    </div>

    <!-- subscribe -->

    <form
      action=""
      class="mt-16 bg-semi-white-1 dark:bg-dark-purple-3 flex justify-between items-center rounded pl-4 pr-[5px] w-[340px]"
    >
      <input
        type="text"
        placeholder="Subscribe"
        class="h-[50px] focus:outline-none bg-transparent flex-1"
      />
      <button
        class="h-10 rounded bg-white dark:bg-dark-purple-1 dark:text-white dark:hover:bg-primary grid place-items-center px-3.5 py-1.5 hover:bg-primary hover:text-white"
        >Subsribe</button
      >
    </form>
  </div>
</footer>
