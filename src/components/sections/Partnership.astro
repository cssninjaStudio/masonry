---
import { Picture, Image } from "@astrojs/image/components";
import { Icon } from "astro-icon";
---

<section class="md:py-12 py-8 px-5 lg:p-12 dark:bg-dark-purple-1 overflow-hidden">
  <div class="container flex flex-col md:flex-row gap-6 items-center">
    <div class="md:w-1/2 flex md:justify-center">
      <div class="max-w-[340px] relative">
        <Picture
          class="h-full relative z-0"
          alt="A robust partnership"
          src="/images/photo/buildings/8.webp"
          widths={[246, 400]}
          aspectRatio={400 / 490}
          sizes={`(min-width: 1024px) 340px,
      (min-width: 768px) 246px, 340px`}
        />

        <!-- composition -->
        <div
          class="absolute z-[2] border border-gray-500/20 -right-12 md:-right-12 -bottom-8 p-6 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px] w-[280px] bg-white dark:bg-dark-purple-2"
        >
          <p
            class="mb-2 flex justify-between items-center text-dark dark:text-white font-TitilliumWeb text-base font-semibold"
          >
            Simply incredible

            <Icon
              name="fluent:star-emphasis-24-filled"
              class="h-[18px] text-[#ffd770]"
            />
          </p>
          <p class="text-blue-gray text-sm">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
          </p>
          <div class="flex items-center gap-2 mt-4">
            <Image
              src="/images/avatars/5.webp"
              alt="Author"
              width={310}
              aspectRatio={1 / 1}
              format="webp"
              class="h-8 w-8 rounded-full"
            />
            <span class="text-ice-blue text-sm"
              >Chris Stappler — Barton Inc.</span
            >
          </div>
        </div>
      </div>
    </div>
    <div class="md:w-1/2 p-3 md:pr-[98px]">
      <h3 class="title-2 font-light">A robust partnership</h3>
      <p class="text-blue-gray text-base py-2">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Illud non
        continuo, ut aeque incontentae. Duo Reges: constructio interrete. Si qua
        in iis corrigere voluit, deteriora fecit. Sit enim idem caecus, debilis.
      </p>

      <ul class="py-4 pl-6">
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">Weekly status meetings</span>
        </li>
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">Project monitoring</span>
        </li>
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">Quarterly process audits</span>
        </li>
      </ul>
    </div>
  </div>
</section>
