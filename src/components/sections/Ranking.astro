---
import { Picture } from "@astrojs/image/components";
import { Icon } from "astro-icon";
---

<section class="py-12 px-6 lg:p-12 dark:bg-dark-purple-1">
  <div class="container flex flex-col md:flex-row gap-6 items-center">
    <div class="md:w-1/2 p-3 md:pl-[5%] lg:pl-[98px]">
      <h3 class="dark:text-white font-TitilliumWeb text-dark text-[2rem] leading-9 font-light">Highest ranking standards</h3>
      <p class="text-blue-gray text-base py-2">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Illud non
        continuo, ut aeque incontentae. Duo Reges: constructio interrete. Si qua
        in iis corrigere voluit, deteriora fecit. Sit enim idem caecus, debilis.
      </p>

      <ul class="py-4 pl-6">
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">AA+ construction standard</span>
        </li>
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">All-Risk insurance</span>
        </li>
        <li class="flex items-center gap-2 py-2">
          <Icon name="lucide:check" class="w-5 text-success aspect-square" />
          <span class="text-ice-blue">Project live tracking</span>
        </li>
      </ul>
    </div>
    <div class="md:w-1/2 flex justify-center">
      <div class="max-w-[340px] relative">
        <Picture
          class="h-full relative z-0"
          alt="Highest ranking standards"
          src="/images/photo/buildings/6.webp"
          widths={[246, 340]}
          aspectRatio={340 / 416}
          sizes={`(min-width: 1024px) 340px,
      (min-width: 768px) 246px, 340px`}
        />

        <!-- composition -->
        <div
          class="absolute z-[2] border border-gray-500/20 -left-8 -bottom-8 py-10 px-5 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px] w-[200px] bg-white dark:bg-dark-purple-2"
        >
          <div
            class="bg-success w-10 aspect-square mx-auto rounded-full grid place-items-center"
          >
            <Icon name="ion:flash" class="w-5 text-white aspect-square" />
          </div>
          <p
            class="text-center my-2 text-dark font-TitilliumWeb text-base dark:text-white font-semibold"
          >
            AA+ Standard
          </p>
          <p class="text-center text-ice-blue text-sm">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
