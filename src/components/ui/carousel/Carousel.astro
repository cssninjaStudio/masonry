---
import { Icon } from "astro-icon";
---

<div
  class="carousel-container relative"
  x-data="{
  swiper: null, 
}"
  x-init="
  this.swiper = initHomeSwiper(this.$refs.container)
"
>
  <div class="swiper-container relative max-h-[440px]" x-ref="container">
    <div class="swiper-caption bg-white absolute bottom-8 max-w-[380px] z-[2]">
      <div class="swiper-caption-inner relative w-full h-full p-8">
        <h3 class="title is-4 is-leading is-thin">High-end properties</h3>
        <p class="text-sm mb-3">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Non enim
          quaero quid verum, sed quid cuique dicendum sit.
        </p>

        <div class="caption-actions flex items-center justify-between">
          <a href="#" class="slide-link">Learn More</a>
          <div class="carousel-controls flex justify-end">
            <button
              @click="swiper.slidePrev()"
              class="flex items-center justify-center outline-none h-8 w-8 text-lg rounded-full cursor-pointer transition-colors duration-300"
            >
              <Icon name="lucide:arrow-left" class="text-white" />
            </button>

            <button
              @click="swiper.slideNext()"
              class="flex items-center justify-center outline-none h-8 w-8 text-lg rounded-full cursor-pointer transition-colors duration-300"
            >
              <Icon name="lucide:arrow-right" class="text-white" />
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="carousel-pagination absolute top-1/2 -translate-y-1/2 rotate-90 z-[3]"
    >
    </div>

    <div class="swiper-wrapper">
      <!-- Slides -->

      {
        [
          "/images/photo/buildings/4.webp",
          "/images/photo/buildings/3.webp",
          "/images/photo/buildings/1.webp",
          "/images/photo/buildings/2.webp",
        ].map((url) => (
          <div class="swiper-slide">
            <div class="slide-inner">
              <div class="slide-content">
                <img
                  class="w-full object-cover h-[280px] lg:h-auto"
                  src={url}
                  alt="Slide Image"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script slot="head">
  import Swiper from "swiper";

  function initHomeSwiper(element) {
    console.log(element);
    return new Swiper(element, {
      loop: true,
      autoplay: {
        delay: 5000,
      },
      slidesPerView: 1,
      spaceBetween: 0,
      effect: "fade",
      fadeEffect: {
        crossFade: true,
      },
      pagination: {
        el: ".carousel-pagination",
        type: "bullets",
      },
      breakpoints: {
        640: {
          slidesPerView: 1,
          spaceBetween: 0,
        },
        768: {
          slidesPerView: 1,
          spaceBetween: 0,
        },
        1024: {
          slidesPerView: 1,
          spaceBetween: 0,
        },
      },
    });
  }
