---
import { Picture } from "@astrojs/image/components";
---

<div class="dark:bg-dark-purple-1">
  <section
    id="PropertyGrid"
    class="container grid gap-2.5 auto-rows-[200px] min-h-screen grid-flow-row-dense grid-cols-[repeat(auto-fit,minmax(200px,1fr))] grid-rows-[repeat(auto-fit,minmax(200px,1fr))] py-12 px-2.5"
  >
    <div class="overflow-hidden col-span-1 row-span-1 bg-[tomato]">
      <Picture
        class="object-cover min-h-full min-w-full"
        src="/images/photo/buildings/4.webp"
        widths={[200, 400]}
        sizes="100%"
        fit={"cover"}
        aspectRatio={1 / 1}
        alt=""
      />
    </div>
    <div class="overflow-hidden col-span-2 row-span-2 bg-[slateBlue]">
