---
import EngageCTA from "@components/sections/EngageCTA.astro";
import IconMatrix from "@components/sections/IconMatrix.astro";
import Logos from "@components/sections/Logos.astro";
import PropertyGrid from "@components/sections/PropertyGrid.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="About">
  <main id="About">
    <section class="dark:bg-dark-purple-1 pb-12 px-6">
      <!-- moving fees  -->
      <div
        class="side-feature pb-12 container flex flex-col md:flex-row items-center"
      >
        <div class="p-3 md:w-2/5 md:ml-[8.3%]">
          <img
            class="dark:hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-1-next.svg"
            alt=""
          />
          <img
            class="dark:block hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-1-dark.svg"
            alt=""
          />
        </div>
        <div class="p-3 md:w-1/3 md:ml-[8.3%]">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-white leading-[1.125] mb-6"
          >
            Don't worry, we take care of your moving fees
          </h3>
          <p class="text-blue-gray text-base">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
            generis est docilitas, memoria; Cur haec eadem Democritus? Memini
            vero, inquam; Duo Reges: constructio interrete.
          </p>
        </div>
      </div>
      <!-- expert agents  -->
      <div
        class="side-feature pb-12 container flex flex-col-reverse md:flex-row items-center"
      >
        <div class="p-3 md:w-1/3 md:ml-[8.3%]">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-white leading-[1.125] mb-6"
          >
            Expert agents help you make your choice
          </h3>
          <p class="text-blue-gray text-base">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
            generis est docilitas, memoria; Cur haec eadem Democritus? Memini
            vero, inquam; Duo Reges: constructio interrete.
          </p>
        </div>

        <div class="p-3 md:w-2/5 md:ml-[8.3%]">
          <img
            class="dark:hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-2-next.svg"
            alt=""
          />
          <img
            class="dark:block hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-2-dark.svg"
            alt=""
          />
        </div>
      </div>
      <!-- Take a nap  -->
      <div
        class="side-feature container flex flex-col md:flex-row items-center"
      >
        <div class="p-3 md:w-2/5 md:ml-[8.3%]">
          <img
            class="dark:hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-3-next.svg"
            alt=""
          />
          <img
            class="dark:block hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-3-dark.svg"
            alt=""
          />
        </div>

        <div class="p-3 md:w-1/3 md:ml-[8.3%]">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-white leading-[1.125] mb-6"
          >
            Take a nap and leave the rest to us
          </h3>
          <p class="text-blue-gray text-base">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
            generis est docilitas, memoria; Cur haec eadem Democritus? Memini
            vero, inquam; Duo Reges: constructio interrete.
          </p>
        </div>
      </div>
    </section>

    <!-- ICON MATRIX -->
    <IconMatrix />
    <!-- GRID -->
    <PropertyGrid />

    <!-- WHAT THEY SAY -->
    <Testimonials centerText={true} />

    <!-- LOGOS -->
    <Logos />

    <!-- ENGAGE/CTA-->
    <EngageCTA />
  </main>
</Layout>
