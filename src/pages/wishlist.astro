---
import { Image } from "@astrojs/image/components";
import { property as properties } from "@data/property";
import Layout from "@layouts/Split.astro";
import PropertyCard from "@components/ui/PropertyCard.astro";
---

<Layout title="Wishlist">
  <main
    id="Wishlist"
    class="py-12 px-6 md:px-12 bg-semi-white-1 dark:bg-dark-blue"
  >
    <section class="container">
      <template x-if="$store.app.isLoggedIn === false">
        <div
          class="placeholder-outer min-h-screen flex justify-center items-center py-12"
        >
          <div class="page-placeholder flex justify-center items-center">
            <div class="page-placeholder-inner text-center">
              <img
                class="max-w-[420px] mx-auto mb-4"
                src="/images/illustrations/placeholder.svg"
                alt=""
              />
              <h3
                class="dark:text-white text-xl mb-2 font-TitilliumWeb text-dark"
              >
                Wishlist not available
              </h3>
              <p class="max-w-[540px] text-base mx-auto mb-4 text-blue-gray">
                Wishlists are only available to logged in users. Please login to
                your account. If you don't have an account, go ahead and create
                one.
              </p>
              <div class="buttons flex justify-center items-center gap-2 mb-1">
                <a
                  href="/login"
                  class="button min-h-[48px] min-w-[130px] bg-primary text-[.9rem] font-medium text-white rounded-[.2rem] cursor-pointer flex justify-center items-center px-4 py-2 text-center hover:[box-shadow:_rgba(46,_49,_255,_0.42)_0px_14px_26px_-12px,_rgba(0,_0,_0,_0.12)_0px_4px_23px_0px,_rgba(46,_49,_255,_0.2)_0px_8px_10px_-5px] transition-all duration-300"
                  >Login</a
                >
                <a
                  href="/home"
                  class="button min-h-[48px] min-w-[130px] rounded-[.2rem] cursor-pointer flex justify-center items-center px-4 py-2 text-center bg-white border border-gray-1"
                  >Back Home</a
                >
              </div>
            </div>
          </div>
        </div>
      </template>

      <template x-if="$store.app.isLoggedIn">
        <div class="account-app">
          <div
            class="account-header flex flex-col md:flex-row items-center pt-16 gap-4"
          >
            <Image
              height={280}
              width={280}
              class="header-avatar h-[60px] w-[60px] rounded-full"
              src="/images/avatars/4.webp"
              alt="Account photo"
            />
            <div class="header-meta">
              <h2
                class="dark:text-white font-TitilliumWeb text-center md:text-left text-dark font-light text-[2rem] leading-[1.125]"
              >
                Wishlist
              </h2>
              <h4 class="text-blue-gray text-xl text-center md:text-left">
                Properties that you liked
              </h4>
            </div>
          </div>

          <div class="account-whishlist py-12" x-data="{ activeTab: 'rent'}">
            <div class="tabs-wrapper">
              <div
                class="tabs mb-6 flex text-base justify-between overflow-hidden overflow-x-auto"
              >
                <ul
                  class="flex items-center flex-grow border-b dark:border-dark-purple-3 border-gray-1 list-none"
                >
                  <li
                    :class="activeTab === 'rent' && 'is-active [&>a]:border-primary [&>a]:text-primary dark:[&>a]:text-semi-white-3'"
                  >
                    <a
                      @click.prevent="activeTab = 'rent'"
                      class="flex justify-center items-center py-2 px-4 border-b border-transparent text-ice-blue cursor-pointer no-underline -mb-px"
                      >Rent</a
                    >
                  </li>
                  <li
                    :class="activeTab === 'buy' && 'is-active  [&>a]:border-primary [&>a]:text-primary dark:[&>a]:text-semi-white-3'"
                  >
                    <a
                      @click.prevent="activeTab = 'buy'"
                      class="flex justify-center items-center py-2 px-4 border-b-2 border-transparent text-ice-blue cursor-pointer no-underline -mb-px"
                      >Buy</a
                    >
                  </li>
                </ul>
              </div>

              <div class="tab-content-wrap">
                <!--For rent-->
                <div
                  x-show.transition="activeTab === 'rent'"
                  class="tab-content"
                >
                  <div class="tab-placeholder">
                    <p class="mb-6 text-ice-blue">
                      <span
                        >Looks like you didn't add properties to rent to your
                        wishlist.</span
                      >
                      <a class="slide-link ml-2 text-primary text-[.95rem]"
                        >Learn more</a
                      >
                    </p>
                    <img src="/images/illustrations/cityline.svg" alt="" />
                  </div>
                </div>

                <!--For sale-->
                <div
                  x-show.transition="activeTab === 'buy'"
                  class="tab-content"
                >
                  <div class="tab-placeholder">
                    <p class="text-ice-blue">
                      <span>These are your favorite properties on sale.</span>
                      <a class="slide-link ml-2 text-primary text-[.95rem]"
                        >Learn More</a
                      >
                    </p>
                  </div>
                  <div
                    class="property-cards py-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
                  >
                    {
                      properties
                        .slice(0, 5)
                        .map((property) => <PropertyCard {...property} />)
                    }
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </template>
    </section>
  </main>
</Layout>
