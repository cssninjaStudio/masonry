---
import Logo from "@components/ui/Logo.astro";
import { APP } from "@data/config";
import Layout from "@layouts/Minimal.astro";
import { Icon } from "astro-icon";
---

<Layout title="Error 404">
  <main
    id="Error"
    class="error-hero min-h-screen flex flex-col items-stretch justify-between bg-semi-white-1 dark:bg-dark-blue relative"
  >
    <header class="error-nav absolute top-0 left-0 z-[5] w-full px-3">
      <div class="container">
        <div
          class="error-nav-inner flex justify-between items-center gap-3 min-h-[4.5rem]"
        >
          <a href="/" class="flex gap-4 items-center">
            <Logo class="h-10 aspect-square" />
            <p
              class="font-medium text-2xl font-TitilliumWeb text-dark dark:text-white"
            >
              {APP.name}
            </p>
          </a>
          <button
            class="darkToggle cursor-pointer relative w-9 aspect-square rounded-full border-gray-1 dark:border-dark-purple-3 border [&>svg]:text-yellow"
            @click="$store.app.toggleTheme()"
          >
            <!-- sun -->
            <Icon
              name="feather:sun"
              class="lightIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
              x-cloak
              :class="$store.app.isDark ? 'opacity-0 -translate-x-[45%] -translate-y-[150%]' : 'opacity-100  -translate-x-1/2 -translate-y-1/2' "
            />

            <!-- moon -->
            <Icon
              name="feather:moon"
              class="darkIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
              x-cloak
              :class="$store.app.isDark ? 'opacity-100  -translate-x-[45%] -translate-y-1/2' : 'opacity-0 -translate-x-[45%] -translate-y-[150%]' "
            />
          </button>
        </div>
      </div>
    </header>

    <div class="flex items-center flex-grow px-6 md:px-12">
      <div class="container">
        <div
          class="error-wrapper relative overflow-hidden flex items-center flex-col justify-center py-12"
        >
          <div class="error-wrapper-inner relative w-full">
            <div class="error-image relative z-[1]">
              <img
                class="light-image-block dark:hidden max-w-[580px] mx-auto w-full block"
                src="/images/illustrations/404.svg"
                alt="Error image"
              />
              <img
                class="dark-image-block hidden dark:block max-w-[580px] mx-auto w-full"
                src="/images/illustrations/404-dark.svg"
                alt="Error image"
              />
            </div>
            <div class="error-content mt-4 text-center">
              <h2
                class="dark:text-white text-[2rem] font-semibold leading-[1.125] font-TitilliumWeb text-dark mb-2"
              >
                <span>Page Not Found</span>
              </h2>
              <p
                class="text-base md:text-[1.15rem] mx-auto max-w-[27.5rem] text-blue-gray mb-4"
              >
                Oops, something went wrong and we couldn't find that page.
                Please try again later.
              </p>
              <div class="buttons flex justify-center items-center gap-2 mb-1">
                <a
                  href="/home-3"
                  class="button min-h-[44px] min-w-[130px] bg-primary text-[.9rem] font-medium text-white rounded-[.2rem] cursor-pointer flex justify-center items-center px-4 py-2 text-center hover:[box-shadow:_rgba(46,_49,_255,_0.42)_0px_14px_26px_-12px,_rgba(0,_0,_0,_0.12)_0px_4px_23px_0px,_rgba(46,_49,_255,_0.2)_0px_8px_10px_-5px] transition-all duration-300"
                  >Homepage</a
                >
                <a
                  class="button min-h-[44px] min-w-[130px] rounded-[.2rem] cursor-pointer flex justify-center items-center px-4 py-2 text-dark dark:text-semi-white-3 text-center bg-white dark:bg-dark-purple-1 border dark:border-dark-purple-8 border-gray-1"
                  >Back</a
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
