---
import { Image } from "@astrojs/image/components";
import SelectBox from "@components/ui/SelectBox.astro";
import Tab from "@components/ui/Tab.astro";
---

<section id="Hero" class="h-[750px] bg-semi-white relative overflow-hidden">
  <div
    id="HeroContent"
    class="container flex flex-col gap-6 justify-center h-full relative z-10"
  >
    <div class="max-w-[380px] flex flex-col gap-6">
      <h1
        class="font-TitilliumWeb font-light text-[48px] leading-[54px] text-dark"
      >
        Find the house of your dreams.
      </h1>
      <p class="paragraph break-words">
        We help you find the perfect space that will make you and your family
        happy.
      </p>
    </div>

    <form action="">
      <!-- tabs -->
      <ul aria-label="Tabs" class="flex relative z-10">
        <li aria-label="Tab">
          <Tab label="Buy" selected={true} />
        </li>
        <li aria-label="Tab">
          <Tab label="Rent" />
        </li>
      </ul>

      <div
        class="p-3 bg-white relative -mt-px z-0 flex gap-2 items-center w-max border border-[#e3e3e3]"
      >
        <!-- select -->
        <SelectBox
          placeholder="Property Type"
          options={[
            "Private residence",
            "Private house",
            "Aparment",
            "Mansion",
          ]}
          id="PropertyType"
        />

        <!-- search input -->
        <div
          class="input-group flex items-center h-full border-l border-[#e3e3e3] flex-row-reverse"
        >
          <input
            type="text"
            placeholder="Search by location"
            class="focus:outline-none h-[60px] w-full"
          />

          <!-- icon -->
          <div
            class="h-[60px] aspect-square text-[#93A5BE] flex justify-center items-center"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-[18px] h-[18px"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
        </div>

        <button
          type="submit"
          class="h-[60px] min-w-[150px] font-medium text-lg px-4 py-2 rounded flex justify-center items-center transition-all duration-300 bg-primary text-white hover:[box-shadow:rgba(46,49,255,0.42)_0px_14px_26px_-12px,rgba(0,0,0,0.12)_0px_4px_23px_0px,rgba(46,49,255,0.2)_0px_8px_10px_-5px]"
          >Search</button
        >
      </div>

      <!-- only new -->
      <div class="text-[#93A5BE] mt-6">
        <label class="inline-flex relative items-center cursor-pointer">
          <input type="checkbox" value="" class="sr-only peer" />
          <div
            class="w-11 h-6 bg-white peer-focus:outline-none [box-shadow:inset_0_0_5px_0_#c7c7c7] rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:[box-shadow:0_2px_2px_rgba(0,0,0,.24)] after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"
          >
          </div>
          <span class="ml-3 text-sm font-medium text-ice-blue"
            >Only include new properties</span
          >
        </label>
      </div>
    </form>
  </div>

  <div class="hero-bg w-1/2 h-full absolute right-0 top-0 z-0">
    <Image
      src={"/images/photo/hero/3.webp"}
      width={900}
      height={1000}
      alt="hero"
      format="webp"
    />
  </div>
</section>

<style>
  .switch input[type="checkbox"]:checked + .switch-inner {
    @apply translate-x-full bg-blue-500;
  }
</style>
