---
import { Picture } from "@astrojs/image/components";
import { Icon } from "astro-icon";
import MegaMenuLink from "./MegaMenuLink.astro";
---

<section
  id="MegaMenuWrapper"
  class="relative top-0 pointer-events-none transition-all bg-white dark:bg-dark-purple-2 grid duration-300"
  data-hover-sustained="false"
>
  <div
    id="propertiesMega"
    data-mega-menu-open="false"
    class="mega pointer-events-none w-full py-[60px]"
  >
    <ul class="container flex gap-5">
      <li class="w-[35%]">
        <div class="megamenu-block">
          <div class="flex gap-4">
            <div>
              <Icon
                name="ph:buildings-duotone"
                class="w-10 aspect-square text-primary"
              />
            </div>

            <div class="flex flex-col">
              <h3
                class="font-TitilliumWeb font-semibold text-xl dark:text-white text-dark mb-3"
              >
                Properties
              </h3>
              <p class="mb-4 text-ice-blue text-base">
                Masonry makes it easy to browse homes. When you’re ready, you
                can also connect with a local agent to explore financing
                solutions
              </p>
              <a href="#" class="flex text-primary">
                <span>Explore all properties</span>
                <Icon name="lucide:arrow-right" class="w-5 aspect-square" />
              </a>
            </div>
          </div>
        </div>
      </li>
      <li class="w-[15%]">
        <div class="megamenu-block has-margin">
          <h4
            class="text-sm font-TitilliumWeb font-semibold text-dark dark:text-white uppercase"
          >
            Categories
          </h4>
          <ul class="flex flex-col gap-2 mt-3">
            <li>
              <MegaMenuLink title="Residences" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Apartments" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Houses" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Mansions" href="#" />
            </li>
          </ul>
        </div>
      </li>
      <li class="w-1/2">
        <div class="megamenu-block flex gap-5">
          <a href="#" class="showcase-item">
            <Picture
              class="h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/1.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 380px`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Barnaby Tower
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
          <a href="#" class="showcase-item">
            <Picture
              class="h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/2.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 380px`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  High Hils
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
        </div>
      </li>
    </ul>
  </div>

  <div
    id="rentalsMega"
    data-mega-menu-open="false"
    class="mega pointer-events-none w-full py-[60px]"
  >
    <ul class="container flex gap-5">
      <li class="w-[35%]">
        <div class="megamenu-block">
          <div class="flex gap-4">
            <div>
              <Icon
                name="ph:house-duotone"
                class="w-10 aspect-square text-primary"
              />
            </div>

            <div class="flex flex-col">
              <h3
                class="font-TitilliumWeb font-semibold text-xl dark:text-white text-dark mb-3"
              >
                Rentals
              </h3>
              <p class="mb-4 text-ice-blue text-base">
                Masonry makes it easy to browse homes. When you’re ready, you
                can also connect with a local agent to explore financing
                solutions
              </p>
              <a href="#" class="flex text-primary">
                <span>Explore all properties</span>
                <Icon name="lucide:arrow-right" class="w-5 aspect-square" />
              </a>
            </div>
          </div>
        </div>
      </li>
      <li class="w-[15%]">
        <div class="megamenu-block has-margin">
          <h4
            class="text-sm font-TitilliumWeb font-semibold text-dark dark:text-white uppercase"
          >
            Categories
          </h4>
          <ul class="flex flex-col gap-2 mt-3">
            <li>
              <MegaMenuLink title="Residences" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Apartments" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Houses" href="#" />
            </li>
            <li>
              <MegaMenuLink title="Mansions" href="#" />
            </li>
          </ul>
        </div>
      </li>
      <li class="w-1/2">
        <div class="megamenu-block flex gap-5">
          <a href="#" class="showcase-item">
            <Picture
              class="h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/3.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 380px`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Cozy Beach House
                </h5>
                <p class="text-ice-blue text-sm">Private residence</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
          <a href="#" class="showcase-item">
            <Picture
              class="h-[190px]"
              alt="showcase"
              src="/images/photo/megamenu/4.webp"
              widths={[370, 380, 500]}
              aspectRatio={500 / 350}
              sizes={`(min-width: 1024px) 500px,
              (min-width: 768px) 370px, 380px`}
            />
            <div class="flex justify-between">
              <div>
                <h5
                  class="font-TitilliumWeb text-base text-dark dark:text-white"
                >
                  Stanislas tower
                </h5>
                <p class="text-ice-blue text-sm">Luxury Apartments</p>
              </div>
              <Icon
                name="ph:house-duotone"
                class="w-5 aspect-square dark:text-ice-blue"
              />
            </div>
          </a>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  #MegaMenuWrapper {
    grid-template-areas: "megamenu";
  }
  #MegaMenuWrapper > * {
    grid-area: megamenu;
  }
  [data-hover-sustained="true"] {
    @apply translate-y-0  opacity-100 pointer-events-auto;
  }
  .mega[data-mega-menu-open="true"] {
    @apply block opacity-100 pointer-events-auto;
  }
  [data-hover-sustained="false"] {
    @apply translate-y-2.5 opacity-0;
  }
  .mega[data-mega-menu-open="false"] {
    @apply opacity-0 hidden;
  }
</style>

<script>
  const megaMenuWrapper = document.querySelector("#MegaMenuWrapper");
  const mainHeaderWrapper = document.querySelector("#HeaderWrapper");

  function addHeaderBackground() {
    const isScrolled = mainHeaderWrapper.dataset.scrolled === "true";

    if (!isScrolled) {
      mainHeaderWrapper.dataset.scrolled = "true";
    }
  }
  function removeHeaderBackground() {
    if (!mainHeaderWrapper.dataset.pastThreshHold === "true") {
      mainHeaderWrapper.dataset.scrolled = "false";
    }
  }

  function closeOpenMenus() {
    const openMenus = [
      ...document.querySelectorAll("[data-mega-menu-open='true']"),
    ];

    openMenus.forEach((megaMenu) => (megaMenu.dataset.megaMenuOpen = "false"));
  }

  const megamenu = [...document.querySelectorAll("[data-megamenu-toggle]")];

  mainHeaderWrapper.addEventListener("mouseleave", () => {
    closeOpenMenus();
    megaMenuWrapper.dataset.hoverSustained = "false";
    removeHeaderBackground();
  });

  megamenu.forEach((mega) => {
    let id = `#${mega.dataset.toggle}`;
    const menu = document.querySelector(id);

    if (menu == null) return;

    mega.addEventListener("mouseenter", () => {
      closeOpenMenus();
      megaMenuWrapper.dataset.hoverSustained = "true";
      menu.dataset.megaMenuOpen = "true";
      addHeaderBackground();
    });
  });
</script>
