---
import Hero from "@components/sections/Hero.astro";
import Popular from "@components/sections/Popular.astro";
import { property } from "@data/property";
import Layout from "@layouts/Default.astro";
import PrivateLoft from "@components/sections/PrivateLoft.astro";
import WhatWeDo from "@components/sections/WhatWeDo.astro";
import Partnership from "@components/sections/Partnership.astro";
import Ranking from "@components/sections/Ranking.astro";
import Talented from "@components/sections/Talented.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import Logos from "@components/sections/Logos.astro";
import EngageCTA from "@components/sections/EngageCTA.astro";
---

<Layout title="Home">
  <main id="Home">
    <!-- HERO -->
    <Hero />

    <!-- POPULAR 3-->
    <Popular properties={property.slice(0, 3)} />

    <!-- COCO BEACH -->
    <PrivateLoft />

    <!-- WHAT WE CAN DO -->
    <WhatWeDo />

    <!-- POPULAR 6 -->
    <Popular properties={property.slice(3)} />

    <!-- TALENTED -->
    <Talented />

    <!-- RANKING -->
    <Ranking />

    <!-- PARTNERSHIP -->
    <Partnership />

    <!-- WHAT THEY SAY -->
    <Testimonials />

    <!-- LOGOS -->
    <Logos />

    <!-- ENGAGE/CTA-->
    <EngageCTA />
  </main>
</Layout>
