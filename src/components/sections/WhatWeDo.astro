---
import { Icon } from "astro-icon";
---

<section class="p-12">
  <div class="container">
    <h3 class="title-2">What we can do to help you</h3>

    <div class="grid grid-cols-4 py-8">
      <!-- 1 -->
      <div
        class="p-9 flex flex-col cursor-pointer group hover:drop-shadow-lg bg-white transition-all"
      >
        <!-- icon -->
        <span
          class="w-14 aspect-square grid place-items-center group-hover:[&>svg]:scale-75 group-hover:[&>span]:scale-100 relative group"
        >
          <Icon
            name="ph:handshake-duotone"
            class="w-10 aspect-square text-primary transition-all duration-200 relative z-10"
          />

          <span
            class="bg-[#eff0ff] absolute inset-0 z-0 scale-0 transition-all duration-300 rounded-full"
          ></span>
        </span>
        <h4 class="text-xl font-TitilliumWeb mt-6 mb-2 text-dark font-semibold">
          Selling
        </h4>
        <p class="mb-6 text-sm leading-6 text-blue-gray">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Summum ením
          bonum exposuit vacuitatem.
        </p>
        <a href="" class="text-primary text-sm font-medium flex gap-1 group"
          >Learn more <Icon
            name="lucide:arrow-right"
            class="w-[18px] aspect-square transition-all duration-300 text-primary group-hover:translate-x-1"
          />
        </a>
      </div>
