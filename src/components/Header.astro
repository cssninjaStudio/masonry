---
import { APP } from "@data/config";
import { Icon } from "astro-icon";
import Logo from "./ui/Logo.astro";
import MegaMenu from "./ui/MegaMenu.astro";
---

<div
  id="HeaderWrapper"
  data-scrolled="false"
  data-drop-menu="false"
  class="fixed top-0 left-0 w-full z-[1000] [&>#header]:bg-white [&[data-scrolled='true']>#header_#RightLinks_li.search]:dark:border-dark-purple-3 [&[data-scrolled='true']>#header]:dark:bg-dark-purple-2 [&[data-scrolled='true']>#header]:dark:border-dark-purple-3 [&>#header]:lg:bg-transparent"
>
  <div id="header">
    <header
      id="MainHeader"
      class="container flex justify-between shadow lg:shadow-none px-3 lg:px-0"
    >
      <div class="flex items-center gap-3 py-3">
        <a href="/" class="flex gap-4 items-center">
          <Logo class="h-10 aspect-square" />
          <p
            class="font-medium text-2xl font-TitilliumWeb text-dark dark:text-white"
          >
            {APP.name}
          </p>
        </a>

        <ul id="LeftLinks" class="hidden lg:flex items-center">
          <li>
            <a
              href="#"
              data-megamenu-toggle
              data-toggle="propertiesMega"
              class="py-2 px-3 leading-6 text-base group text-blue-gray hover:text-white flex items-center gap-1"
              >Properties <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:rotate-180 transition-transform duration-300"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </a>
          </li>
          <li class="">
            <a
              href="#"
              data-toggle="rentalsMega"
              data-megamenu-toggle
              class="py-2 px-3 leading-6 group text-base text-blue-gray hover:text-white flex items-center gap-1"
              >Rentals <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:rotate-180 transition-transform duration-300"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="py-2 px-3 leading-6 text-base text-blue-gray block"
              >About</a
            >
          </li>
        </ul>
      </div>

      <ul id="RightLinks" class="hidden lg:flex items-center gap-6">
        <li class="h-max flex justify-center items-center">
          <a href="/" class="py-2 leading-6 text-base text-white">Sign In</a>
        </li>

        <!-- search -->
        <li
          class="search h-max pl-6 flex justify-center items-center dark:border-dark-purple-3"
        >
          <a href="" class="inline-block text-base text-white">
            <svg
              class="w-4"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="--darkreader-inline-stroke: currentColor;"
              data-darkreader-inline-stroke=""
              ><circle cx="11" cy="11" r="8"></circle><line
                x1="21"
                y1="21"
                x2="16.65"
                y2="16.65"></line>
            </svg>
          </a>
        </li>

        <!-- whishlist -->
        <li class="h-max flex justify-center items-center">
          <a href="/about" class="inline-block text-base text-white">
            <Icon name="lucide:heart" class="w-4 aspect-auto" />
          </a>
        </li>

        <!-- dark/light mode switch -->
        <li class="h-max flex justify-center items-center">
          <button
            data-dark-mode="false"
            class="darkToggle relative w-9 aspect-square rounded-full"
          >
            <!-- sun -->
            <Icon
              name="feather:sun"
              class="lightIcon w-4 text-white aspect-auto absolute"
            />

            <!-- moon -->
            <Icon
              name="feather:moon"
              class="darkIcon w-4 text-white aspect-auto absolute"
            />
          </button>
        </li>

        <!-- register -->
        <li class="h-max">
          <a
            href="/register"
            class="h-[46px] min-w-[120px] font-medium text-sm leading-6 px-3.5 py-1.5 flex justify-center items-center transition-all duration-300 rounded bg-primary text-white"
            >Register</a
          >
        </li>
      </ul>

      <button id="MenuToggle" class="lg:hidden">
        <svg
          id="OpenIcon"
          class="pointer-events-none text-blue-gray w-8 aspect-auto"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="xMidYMid meet"
          viewBox="0 0 24 24"
          ><path
            fill="currentColor"
            d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2Z"></path>
        </svg>

        <svg
          id="CloseIcon"
          class="pointer-events-none text-blue-gray w-8 aspect-auto"
          xmlns="http://www.w3.org/2000/svg"
          preserveAspectRatio="xMidYMid meet"
          viewBox="0 0 32 32"
          ><path
            fill="currentColor"
            d="M24 9.4L22.6 8L16 14.6L9.4 8L8 9.4l6.6 6.6L8 22.6L9.4 24l6.6-6.6l6.6 6.6l1.4-1.4l-6.6-6.6L24 9.4z"
          ></path>
        </svg>
      </button>
    </header>
  </div>

  <MegaMenu />

  <div
    id="MobileNav"
    class="hidden pt-5 pb-8 px-3 dark:bg-dark-purple-2 bg-white"
  >
    <ul class="lg:hidden flex flex-col items-center gap-1 w-full">
      <li>
        <a
          href="#"
          class="py-2 px-3 leading-6 text-base text-blue-gray flex items-center gap-1"
          >Properties <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="#"
          class="py-2 px-3 leading-6 text-base text-blue-gray flex items-center gap-1"
          >Rentals <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-4 h-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
          </svg>
        </a>
      </li>
      <li>
        <a
          href="/about"
          class="py-2 px-3 leading-6 text-base text-blue-gray block">About</a
        >
      </li>
      <li class="h-max flex justify-center items-center">
        <a href="/" class="py-2 leading-6 text-base text-blue-gray">Sign In</a>
      </li>

      <!-- dark/light mode switch -->
      <li class="h-max flex justify-center items-center">
        <button
          id=""
          data-dark-mode="false"
          class="darkToggle relative w-9 aspect-square rounded-full"
        >
          <!-- sun -->
          <Icon
            id=""
            name="feather:sun"
            class="lightIcon w-4 text-blue-gray aspect-auto absolute"
          />

          <!-- moon -->
          <Icon
            id=""
            name="feather:moon"
            class="darkIcon w-4 text-blue-gray aspect-auto absolute"
          />
        </button>
      </li>

      <!-- register -->
      <li class="h-max w-full md:w-3/5">
        <a
          href="/register"
          class="h-[46px] w-full font-medium text-sm leading-6 px-3.5 py-1.5 flex justify-center items-center transition-all duration-300 rounded bg-primary text-white"
          >Register</a
        >
      </li>
    </ul>
  </div>
</div>

<style>
  [data-dark-mode="false"] .darkIcon,
  [data-dark-mode="true"] .lightIcon {
    @apply opacity-0 -top-full left-1/2;
  }
  [data-dark-mode="true"] .darkIcon,
  [data-dark-mode="false"] .lightIcon {
    @apply opacity-100 top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2;
  }
  [data-drop-menu="true"] header button#MenuToggle #OpenIcon,
  [data-drop-menu="false"] header button#MenuToggle #CloseIcon {
    @apply hidden;
  }

  [data-drop-menu="true"] #MobileNav {
    @apply block;
  }
  [data-drop-menu="false"] #MobileNav {
    @apply hidden;
  }
  [data-scrolled="true"] #header {
    @apply bg-white  border-b border-[#e3e3e3] dark:bg-dark-purple-2  [box-shadow:0_0_10px_0_rgba(0,0,0,.08)]  dark:border-dark-purple-3;
  }
  [data-scrolled="true"] header ul#RightLinks li:nth-child(2) {
    @apply border-l border-[#e3e3e3] dark:border-dark-purple-3 h-full;
  }

  [data-scrolled="true"] header ul#RightLinks li:first-child a,
  [data-scrolled="true"] header ul#RightLinks li svg {
    @apply text-blue-gray;
  }
  [data-scrolled="true"] header ul#RightLinks li button#darkToggle {
    @apply border border-blue-gray;
  }
  [data-scrolled="true"] header ul#RightLinks li button svg {
    @apply text-[#ffd770];
  }
  [data-scrolled="true"] header ul#RightLinks li:last-child a {
    @apply [box-shadow:rgba(46,49,255,0.42)_0px_14px_26px_-12px,rgba(0,0,0,0.12)_0px_4px_23px_0px,rgba(46,49,255,0.2)_0px_8px_10px_-5px];
  }
</style>

<script>
  const menuBtn = document.querySelector("#MenuToggle");
  const headWrapper = document.querySelector("#HeaderWrapper");

  menuBtn.addEventListener("click", () => {
    const DROPPED = headWrapper.dataset.dropMenu === "true";

    if (DROPPED) {
      headWrapper.dataset.dropMenu = "false";
    } else {
      headWrapper.dataset.dropMenu = "true";
    }
  });
</script>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const headWrapper = document.querySelector("#HeaderWrapper");
    const targets = [
      document.querySelector("#HeroContent h1"),
      ...document.querySelectorAll("div"),
    ];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const scrollThreshold = 40;
            if (
              document.documentElement.scrollTop > scrollThreshold ||
              document.body.scrollTop > scrollThreshold
            ) {
              headWrapper.dataset.scrolled = "true";
              headWrapper.dataset.pastThreshHold = "true";
            } else {
              headWrapper.dataset.scrolled = "false";
            }
          }
        });
      },
      { rootMargin: "-300px" }
    );
    targets.forEach((target) => {
      observer.observe(target);
    });
  });
</script>

<script>
  import { setDarkTheme, setLightTheme, themeIsDark } from "@utils/utils";

  [...document.querySelectorAll(".darkToggle")].forEach((themeToggle) => {
    themeToggle.addEventListener("click", () => {
      if (themeIsDark()) {
        setLightTheme();

        themeToggle.dataset.darkMode = "false";
      } else {
        setDarkTheme();
        themeToggle.dataset.darkMode = "true";
      }
    });
  });
</script>
