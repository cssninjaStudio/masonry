---
import { APP } from "@data/config";
import { Icon } from "astro-icon";
import Logo from "./ui/Logo.astro";
import MegaMenu from "./ui/MegaMenu.astro";
import AccountMenu from "./ui/AccountMenu.astro";
---

<div
  id="HeaderWrapper"
  x-data="navbar"
  x-on:scroll.window="scroll()"
  x-on:mouseleave="megamenuOpened = false"
  role="navigation"
  aria-label="main navigation"
  class="fixed top-0 left-0 w-full z-50"
>
  <div
    id="header"
    :class="scrolled || megamenuOpened || mobileOpen  ? 'bg-white border-b border-gray-1 dark:bg-dark-purple-2  [box-shadow:0_0_10px_0_rgba(0,0,0,.08)]  dark:border-dark-purple-3': 'lg:bg-transparent' "
  >
    <header
      id="MainHeader"
      class="min-h-[70px] container flex justify-start items-stretch gap-3 shadow lg:shadow-none px-3 lg:px-0"
    >
      <div
        class="brand flex justify-between lg:justify-start items-center w-full lg:w-auto min-h-[3.25rem]"
      >
        <a href="/" class="flex gap-4 items-center py-2">
          <Logo class="h-10 aspect-square" />
          <p
            class="font-medium text-2xl font-TitilliumWeb text-dark dark:text-white"
          >
            {APP.name}
          </p>
        </a>
        <div class="flex items-stretch gap-3">
          <button
            id="MenuToggle"
            class="lg:hidden"
            @click="mobileOpen = !mobileOpen"
          >
            <svg
              id="OpenIcon"
              class="pointer-events-none text-blue-gray w-8 aspect-auto"
              x-show="!mobileOpen"
              x-cloak
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid meet"
              viewBox="0 0 24 24"
              ><path
                fill="currentColor"
                d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2Z"></path>
            </svg>

            <svg
              id="CloseIcon"
              class="pointer-events-none text-blue-gray w-8 aspect-auto"
              x-show="mobileOpen"
              x-cloak
              xmlns="http://www.w3.org/2000/svg"
              preserveAspectRatio="xMidYMid meet"
              viewBox="0 0 32 32"
              ><path
                fill="currentColor"
                d="M24 9.4L22.6 8L16 14.6L9.4 8L8 9.4l6.6 6.6L8 22.6L9.4 24l6.6-6.6l6.6 6.6l1.4-1.4l-6.6-6.6L24 9.4z"
              ></path>
            </svg>
          </button>

          <template x-if="$store.app.isLoggedIn">
            <div class="lg:hidden flex items-center justify-center">
              <AccountMenu />
            </div>
          </template>
        </div>
      </div>

      <nav
        aria-label="Main Navigation"
        x-cloak
        class="absolute top-full bg-white lg:bg-transparent left-0 w-full lg:static px-3 lg:px-0 lg:flex-grow items-stretch justify-between"
        :class="mobileOpen ? 'block pt-5 pb-8 lg:p-0 -translate-y-px border-b border-gray-1 dark:bg-dark-purple-2  [box-shadow:0_2px_10px_0_rgba(0,0,0,.08)]  dark:border-dark-purple-3': 'hidden lg:flex'"
      >
        <ul
          id="LeftLinks"
          class="flex flex-col lg:flex-row items-stretch [&>li>a]:h-full"
        >
          <li class="">
            <a
              href="#"
              x-on:mouseover="megamenuOpened = true, openedMegamenu = 'megamenu-1'"
              @click="megamenuOpened = true, openedMegamenu = 'megamenu-1'"
              class="py-2 px-3 leading-6 text-base group text-blue-gray hover:text-dark dark:hover:text-white transition-all duration-300 flex items-center justify-center gap-1"
              >Properties <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:rotate-180 transition-transform duration-300"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </a>
          </li>
          <li class="">
            <a
              href="#"
              x-on:mouseover="megamenuOpened = true, openedMegamenu = 'megamenu-2'"
              @click="megamenuOpened = true, openedMegamenu = 'megamenu-2'"
              class="py-2 px-3 leading-6 group text-base text-blue-gray hover:text-dark dark:hover:text-white transition-all duration-300 flex items-center justify-center gap-1"
              >Rentals <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:rotate-180 transition-transform duration-300"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </a>
          </li>
          <li>
            <a
              href="/about"
              class="py-2 px-3 leading-6 grid place-items-center text-base text-blue-gray hover:text-dark dark:hover:text-white transition-all duration-300"
              >About</a
            >
          </li>
        </ul>

        <ul
          id="RightLinks"
          class="flex flex-col lg:flex-row items-stretch gap-6 [&>li>a]:h-full [&>li>a]:grid [&>li>a]:place-items-center"
        >
          <template x-if="$store.app.isLoggedIn === false">
            <li class="">
              <a
                href="/"
                class="py-2 leading-6 text-base hover:text-dark dark:hover:text-white transition-all duration-300"
                :class="scrolled ||  megamenuOpened ? 'text-blue-gray' : 'text-blue-gray lg:text-white'"
                >Sign In</a
              >
            </li>
          </template>

          <!-- search -->
          <li
            class="search lg:pl-6 hidden lg:block"
            :class="scrolled  ||  megamenuOpened ? 'border-gray-1 dark:border-dark-purple-3': 'border-transparent',{'lg:border-l':!$store.app.isLoggedIn}  "
          >
            <a
              href=""
              class="inline-block text-base text-blue-gray lg:text-white hover:text-dark dark:hover:text-white transition-all duration-300"
            >
              <svg
                class="w-4"
                :class="{'text-blue-gray hover:text-dark dark:hover:text-white transition-all duration-300': scrolled  ||  megamenuOpened}"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                style="--darkreader-inline-stroke: currentColor;"
                data-darkreader-inline-stroke=""
                ><circle cx="11" cy="11" r="8"></circle><line
                  x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65"></line>
              </svg>
            </a>
          </li>

          <!-- whishlist -->
          <li class="hidden lg:block">
            <a
              href="/about"
              class="inline-block text-base text-white hover:text-dark dark:hover:text-white transition-all duration-300"
            >
              <Icon
                name="lucide:heart"
                class="w-4 aspect-auto"
                :class="{'text-blue-gray hover:text-dark dark:hover:text-white transition-all duration-300': scrolled  ||  megamenuOpened || mobileOpen }"
              />
            </a>
          </li>

          <!-- dark/light mode switch -->
          <li class="flex justify-center items-center">
            <button
              class="darkToggle relative w-9 aspect-square rounded-full overflow-hidden border-gray-1 dark:border-dark-purple-3"
              :class="scrolled  ||  megamenuOpened || mobileOpen ? 'border [&>svg]:text-yellow dark:bg-dark-purple-2' : '[&>svg]:text-white'"
              @click="$store.app.toggleTheme()"
            >
              <!-- sun -->
              <Icon
                name="feather:sun"
                class="lightIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
                :class="$store.app.isDark ? 'opacity-0 -translate-x-[45%] translate-y-[150%]' : 'opacity-100  -translate-x-1/2 -translate-y-1/2' "
              />

              <!-- moon -->
              <Icon
                name="feather:moon"
                class="darkIcon left-1/2 aspect-auto absolute top-1/2 [&>*]:fill-current transition-all duration-300"
                :class="$store.app.isDark ? 'opacity-100  -translate-x-[45%] -translate-y-1/2' : 'opacity-0 -translate-x-[45%] -translate-y-[150%]' "
              />
            </button>
          </li>

          <template x-if="$store.app.isLoggedIn === false">
            <!-- register -->
            <li
              class="w-full md:w-3/5 mx-auto lg:mx-0 lg:w-auto flex items-center justify-center"
            >
              <a
                href="/register"
                class="!h-[46px] w-full lg:w-auto min-w-[120px] font-medium text-sm leading-6 px-3.5 py-1.5 flex justify-center items-center transition-all duration-300 rounded bg-primary text-white"
                :class="{'[box-shadow:rgba(46,49,255,0.42)_0px_14px_26px_-12px,rgba(0,0,0,0.12)_0px_4px_23px_0px,rgba(46,49,255,0.2)_0px_8px_10px_-5px]': scrolled}"
                >Register</a
              >
            </li>
          </template>

          <template x-if="$store.app.isLoggedIn">
            <div class="hidden lg:flex items-center justify-center">
              <AccountMenu />
            </div>
          </template>
        </ul>
      </nav>
    </header>
  </div>
  <MegaMenu />
</div>

<script>
  document.addEventListener("alpine:init", () => {
    // Main Navbar Data

    Alpine.data("navbar", () => ({
      scrolled: false,
      height: 60,
      mobileOpen: false,
      megamenuOpened: false,
      openedMegamenu: "megamenu-1",

      scroll() {
        let scrollValue = window.scrollY;
        if (scrollValue >= this.height) {
          this.scrolled = true;
        } else {
          this.scrolled = false;
        }
        this.searchExpanded = false;
      },
      openMobileMenu() {
        this.mobileOpen = !this.mobileOpen;
      },
      logout() {
        setTimeout(() => {
          this.$store.app.logout();
          window.location.href = "/home";
        }, 200);
      },
      init() {
        document
          .querySelectorAll('.scroll-link[href^="#"]')
          .forEach((trigger) => {
            trigger.onclick = function (e) {
              e.preventDefault();
              let hash = this.getAttribute("href");
              let target = document.querySelector(hash);
              let headerOffset = 100;
              let elementPosition = target.offsetTop;
              let offsetPosition = elementPosition - headerOffset;

              window.scrollTo({
                top: offsetPosition,
                behavior: "smooth",
              });
            };
          });
      },
    }));
  });
</script>
