---
import LayoutSplit from "@layouts/LayoutSplit.astro";
import Icon from "astro-icon";
---

<LayoutSplit>
  <main id="Settings" class="py-12 px-6 md:px-12 dark:bg-dark-purple-1">
    <section class="container">
      <!-- account-header -->
      <div class="flex flex-col md:flex-row items-center pt-16 gap-4">
        <!-- header-avatar -->

        <img
          class="h-[60px] aspect-square rounded-full block min-w-[60px]"
          src="/images/avatars/4.webp"
          alt="avatar"
        />
        <!-- header-meta -->
        <div class="">
          <h2
            class="dark:text-white font-TitilliumWeb text-center md:text-left text-dark font-light text-[2rem]"
          >
            Personal Info
          </h2>
          <h4 class="text-blue-gray text-xl text-center md:text-left">
            Edit your personal details
          </h4>
        </div>
      </div>

      <div
        class="py-12 flex md:flex-row flex-col gap-12 md:gap-0 md:justify-between"
      >
        <div class="w-full md:w-[58%]">
          <div class="account-block">
            <div class="mb-12">
              <h2
                class="dark:text-white text-dark font-light font-TitilliumWeb text-xl"
              >
                General
              </h2>
              <h4 class="text-blue-gray">
                Your general information and details
              </h4>
            </div>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Full Name</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >Henry Miller</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Gender</span>
                <span class="block text-dark dark:text-semi-white-3">Male</span>
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Email Address</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >henrymiller@gmail.com</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Birthdate</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >August 24, 1984</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>
          </div>

          <!-- account block -->
          <div
            class="account-block pt-14 mt-14 border-t border-gray-1 dark:border-dark-purple-6"
          >
            <div class="mb-12">
              <h2
                class="dark:text-white text-dark font-light font-TitilliumWeb text-xl"
              >
                Additional Info
              </h2>
              <h4 class="text-blue-gray">
                some additional details that we need
              </h4>
            </div>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Phone Number</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >(+1) 555 551 54984</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">ID Document</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >Successfully uploaded</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Location</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >San Francisco, CA</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>

            <!--Setting block-->
            <article
              class="media flex items-center gap-4 [&+.media]:mt-4 [&+.media]:pt-4 [&+.media]:border-t [&+.media]:border-gray-1 dark:[&+.media]:border-dark-purple-6"
            >
              <div class="media-content flex-1">
                <span class="block text-ice-blue text-base">Emergency</span>
                <span class="block text-dark dark:text-semi-white-3"
                  >Your emergency infos</span
                >
              </div>
              <div class="media-right">
                <a class="default-link text-primary font-medium">Edit</a>
              </div>
            </article>
          </div>
        </div>
        <!-- account categories -->
        <div class="w-full md:w-1/3">
          <!--Category-->
          <a
            href="/account"
            class="card mb-6 border border-gray-1 dark:border-dark-purple-6 dark:hover:border-primary hover:border-primary block transition-all duration-300"
          >
            <div class="card-content p-6 dark:bg-dark-purple-2">
              <div class="card-icon">
                <Icon class="h-8 text-success" name="ph:shield-check-duotone" />
              </div>
              <h3
                class="dark:text-white text-dark font-light font-TitilliumWeb text-base mb-2"
              >
                <span class="icon-text font-semibold flex items-center">
                  <span>Account & Security</span>
                  <span class="icon transition-transform duration-300">
                    <Icon name="chevron-right h-[18px] w-[18px]" />
                  </span>
                </span>
              </h3>
              <p class="text-base text-blue-gray">
                Update your password and secure your account. You can also
                enable two-factor authentication.
              </p>
            </div>
          </a>
          <!--Category-->
          <a
            href="/account"
            class="card border border-gray-1 dark:border-dark-purple-6 dark:hover:border-primary hover:border-primary block transition-all duration-300"
          >
            <div class="card-content p-6 dark:bg-dark-purple-2">
              <div class="card-icon">
                <Icon class="h-8 text-info" name="ph:credit-card-duotone" />
              </div>
              <h3
                class="dark:text-white text-dark font-light font-TitilliumWeb text-base mb-2"
              >
                <span class="icon-text font-semibold flex items-center">
                  <span>Payments</span>
                  <span class="icon transition-transform duration-300">
                    <Icon name="chevron-right h-[18px] w-[18px]" />
                  </span>
                </span>
              </h3>
              <p class="text-base text-blue-gray">
                View your payments and your transactions. Also view coupon
                codes, gift cards and tax reports.
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>
  </main>
</LayoutSplit>
