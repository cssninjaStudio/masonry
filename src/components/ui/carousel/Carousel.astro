---
import { Icon } from "astro-icon";
---

<div class="carousel-container relative" x-data="homeSwiper">
  <div
    class="swiper-container relative max-h-[440px] overflow-hidden"
    x-ref="container"
  >
    <div
      class="swiper-caption bg-white dark:bg-dark-purple-3 absolute bottom-8 right-8 max-w-[380px] z-[2]"
    >
      <div class="swiper-caption-inner relative w-full h-full p-8">
        <h3
          class="dark:text-white text-2xl font-TitilliumWeb text-dark mb-2 is-thin"
        >
          High-end properties
        </h3>
        <p class="text-sm mb-3 text-blue-gray">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Non enim
          quaero quid verum, sed quid cuique dicendum sit.
        </p>

        <div class="caption-actions flex items-center justify-between">
          <a href="#" class="slide-link text-primary">Learn More</a>
          <div class="carousel-controls flex justify-end">
            <button
              @click="swiper.slidePrev()"
              class="flex items-center justify-center outline-none h-8 aspect-square text-lg rounded-full cursor-pointer transition-colors duration-300 text-dark dark:text-white hover:bg-semi-white-1 hover:dark:bg-dark-purple-3"
            >
              <Icon name="lucide:arrow-left" class="h-[18px] aspect-auto" />
            </button>

            <button
              @click="swiper.slideNext()"
              class="flex items-center justify-center outline-none h-8 aspect-square text-lg rounded-full cursor-pointer transition-colors duration-300 text-dark dark:text-white hover:bg-semi-white-1 hover:dark:bg-dark-purple-3"
            >
              <Icon name="lucide:arrow-right" class="h-[18px] aspect-auto" />
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="carousel-pagination absolute top-1/2 left-4 -translate-y-1/2 rotate-90 z-[3]"
    >
    </div>

    <div class="swiper-wrapper">
      <!-- Slides -->

      {
        [
          "/images/photo/buildings/4.webp",
          "/images/photo/buildings/3.webp",
          "/images/photo/buildings/1.webp",
          "/images/photo/buildings/2.webp",
        ].map((url) => (
          <div class="swiper-slide">
            <div class="slide-inner">
              <div class="slide-content">
                <img
                  class="w-full object-cover h-[280px] lg:h-auto"
                  src={url}
                  alt="Slide Image"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style lang="scss">
  .swiper-pagination-bullet {
    background: none;
    border: 2px solid var(--white);
    opacity: 1;
    transition: background-color 0.3s;

    &.swiper-pagination-bullet-active {
      background: var(--white);
    }
  }
</style>
