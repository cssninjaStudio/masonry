        <div class="w-full md:w-1/3 flex flex-col gap-5 mb-5 md:-mt-[90px]">
          <div class="box-wrap">
            <div
              class="icon-box dark:bg-dark-purple-2 p-8 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px]"
            >
              <img
                class="w-[54px] h-auto dark:hidden"
                src="/images/icons/f1.svg"
                alt=""
              />
              <img
                class="w-[54px] h-auto hidden dark:block"
                src="/images/icons/f1-dark.svg"
                alt=""
              />
              <h4
                class="box-title py-1.5 text-lg text-dark dark:text-semi-white-2"
              >
                Furnitures
              </h4>
              <p class="text-[.9rem] text-blue-gray">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
                generis est docilitas, memoria; Cur haec eadem Democritus?
                Memini vero, inquam.
              </p>
            </div>
          </div>
          <div class="box-wrap">
            <div
              class="icon-box dark:bg-dark-purple-2 p-8 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px]"
            >
              <img
                class="w-[54px] h-auto dark:hidden"
                src="/images/icons/f2.svg"
                alt=""
              />
              <img
                class="w-[54px] h-auto hidden dark:block"
                src="/images/icons/f2-dark.svg"
                alt=""
              />
              <h4
                class="box-title py-1.5 text-lg text-dark dark:text-semi-white-2"
              >
                Windows & Light
              </h4>
              <p class="text-[.9rem] text-blue-gray">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
                generis est docilitas, memoria; Cur haec eadem Democritus?
                Memini vero, inquam.
              </p>
            </div>
          </div>
        </div>
        <div class="w-full md:w-1/3 flex flex-col gap-5 mb-5 mt-5 md:mt-10">
          <div class="box-wrap">
            <div
              class="icon-box dark:bg-dark-purple-2 p-8 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px]"
            >
              <img
                class="w-[54px] h-auto dark:hidden"
                src="/images/icons/f3.svg"
                alt=""
              />
              <img
                class="w-[54px] h-auto hidden dark:block"
                src="/images/icons/f3-dark.svg"
                alt=""
              />
              <h4
                class="box-title py-1.5 text-lg text-dark dark:text-semi-white-2"
              >
                Bathrooms
              </h4>
              <p class="text-[.9rem] text-blue-gray">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
                generis est docilitas, memoria; Cur haec eadem Democritus?
                Memini vero, inquam.
              </p>
            </div>
          </div>
          <div class="box-wrap">
            <div
              class="icon-box dark:bg-dark-purple-2 p-8 [box-shadow:rgba(0,0,0,0.06)_-1px_3px_10px_0px]"
            >
              <img
                class="w-[54px] h-auto dark:hidden"
                src="/images/icons/f4.svg"
                alt=""
              />
              <img
                class="w-[54px] h-auto hidden dark:block"
                src="/images/icons/f4-dark.svg"
                alt=""
              />
              <h4
                class="box-title py-1.5 text-lg text-dark dark:text-semi-white-2"
              >
                Kitchens
              </h4>
              <p class="text-[.9rem] text-blue-gray">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
                generis est docilitas, memoria; Cur haec eadem Democritus?
                Memini vero, inquam.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SIDE FEATURES -->
    <section class="dark:bg-dark-purple-1 pb-12 px-6">
      <!-- moving fees  -->
      <div
        class="side-feature pb-12 container flex flex-col md:flex-row items-center"
      >
        <div class="p-3 md:w-2/5 md:ml-[8.3%]">
          <img
            class="dark:hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-1-next.svg"
            alt=""
          />
          <img
            class="dark:block hidden w-full h-[326px] md:h-auto"
            src="/images/illustrations/feature-1-dark.svg"
            alt=""
          />
        </div>
        <div class="p-3 md:w-1/3 md:ml-[8.3%]">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-white leading-[1.125] mb-6"
          >
            Don't worry, we take care of your moving fees
          </h3>
          <p class="text-blue-gray text-base">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
            generis est docilitas, memoria; Cur haec eadem Democritus? Memini
            vero, inquam; Duo Reges: constructio interrete.
          </p>
        </div>
      </div>
      <!-- expert agents  -->
      <div
        class="side-feature pb-12 container flex flex-col-reverse md:flex-row items-center"
      >
        <div class="p-3 md:w-1/3 md:ml-[8.3%]">
          <h3
            class="font-TitilliumWeb font-light text-[2rem] text-dark dark:text-white leading-[1.125] mb-6"
          >
            Expert agents help you make your choice
          </h3>
          <p class="text-blue-gray text-base">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Prioris
