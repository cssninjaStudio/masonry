---
import Layout from "@layouts/Split.astro";
import Partnership from "@components/sections/Partnership.astro";
import Ranking from "@components/sections/Ranking.astro";
import Talented2 from "@components/sections/Talented2.astro";
import Testimonials from "@components/sections/Testimonials.astro";
import Carousel from "@components/ui/carousel/Carousel.astro";
import NumberBox from "@components/ui/number-boxes/NumberBox.astro";
import ProjectCarousel from "@components/ui/carousel/ProjectCarousel.astro";
import { investProjects } from "@data/property";
import { Icon } from "astro-icon";
import Logos from "@components/sections/Logos.astro";
import EngageCTA from "@components/sections/EngageCTA.astro";
---

<Layout title="Home">
  <main id="Home">
    <section class="px-6 py-12 lg:px-12 dark:bg-dark-purple-1 lg:min-h-screen">
      <div class="container">
        <div
          class="grid grid-cols-1 md:grid-cols-2 items-center gap-4 md:gap-12 pt-16 pb-8"
        >
          <h1
            class="font-TitilliumWeb dark:text-white font-normal text-4xl md:text-5xl text-left md:leading-[1.125] text-dark"
          >
            The home of excellence in the construction industry
          </h1>
          <p class="mb-3 text-base text-ice-blue">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Non enim
            quaero quid verum, sed quid cuique dicendum sit. Quid affers, cur
            Thorius, cur Caius.
          </p>
        </div>

        <Carousel />
      </div>
    </section>

    <!-- TRANSACTION FLOW PROCESS -->

    <section
      class="px-6 py-12 lg:px-12 dark:bg-dark-purple-1 overflow-hidden md:overflow-auto"
    >
      <div class="container">
        <div class="lg:max-w-[940px]">
          <h2
            class="font-TitilliumWeb dark:text-white font-light md:font-normal text-[2rem] leading-9 text-left md:leading-[1.125] text-dark"
          >
            We make sure our lovely customers are always involved so, every
            transaction flow process in our company is a must for them.
          </h2>
        </div>

        <div class="number-boxes py-8">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div
              class="column py-3 relative before:content-[''] before:absolute before:top-0 before:rounded-[100rem] before:bg-primary before:opacity-[0.07] before:h-[125%] before:w-40 before:z-0 before:rotate-45 before:-translate-y-16 before:translate-x-10"
            >
              <NumberBox title="Pre-Construction" number="01" />
            </div>
            <div
              class="column py-3 relative before:content-[''] before:absolute before:top-0 before:rounded-[100rem] before:bg-primary before:opacity-[0.07] before:h-[125%] before:w-40 before:z-0 before:rotate-45 before:-translate-y-[8rem] before:translate-x-20"
            >
              <NumberBox title="Construction" number="02" />
            </div>
            <div
              class="column py-3 relative before:content-[''] before:absolute before:top-0 before:rounded-[100rem] before:bg-primary before:opacity-[0.07] before:h-[125%] before:w-40 before:z-0 before:rotate-45 before:translate-x-full"
            >
              <NumberBox title="Post-Construction" number="03" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RECENT PROJECT -->

    <section
      class="px-6 py-12 lg:px-12 dark:bg-dark-purple-1 overflow-hidden md:overflow-auto"
    >
      <div class="container">
        <div class="section-title lg:max-w-[940px]">
          <h2
            class="font-TitilliumWeb dark:text-white font-light text-[2rem] text-center md:text-left md:leading-[1.125] text-dark"
          >
            Some of our recent projects
          </h2>
        </div>

        <ProjectCarousel />
      </div>
    </section>

    <!-- TALENTED ARCHITECTS  -->
    <Talented2 />

    <!-- RANKING -->
    <Ranking />

    <!-- PARTNERSHIP -->
    <Partnership />

    <!-- INVEST IN OUR PROJECTS -->

    <section
      class="px-6 py-12 lg:px-12 dark:bg-dark-purple-1 overflow-hidden md:overflow-auto"
    >
      <div class="container">
        <div class="section-title max-w-[940px]">
          <h2
            class="font-TitilliumWeb dark:text-white font-light text-[2rem] text-center md:text-left md:leading-[1.125] text-dark"
          >
            Invest in one of our projects
          </h2>
        </div>

        <div class="invest-projects relative py-8">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              investProjects.map((project) => (
                <div class="block">
                  <a
                    href="#"
                    class="invest-project group relative block overflow-hidden"
                  >
                    <img
                      src={project.image}
                      class="group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 block w-full grayscale-[.5] opacity-90 transition-all duration-300"
                      alt={project.title}
                    />
                    <div class="overlay absolute top-0 left-0 h-full w-full">
                      <div class="overlay-inner relative w-full h-full flex flex-col justify-end p-6">
                        <div class="overlay-content p-6 bg-white dark:bg-dark-purple-2">
                          <div class="text-content flex justify-between">
                            <div>
                              <h3 class="dark:text-white text-2xl font-TitilliumWeb text-dark">
                                {project.title}
                              </h3>
                              <p class="text-base text-ice-blue">
                                {project.type}
                              </p>
                            </div>
                            <Icon
                              class="h-6 text-primary"
                              name="ph:house-duotone"
                            />
                          </div>
                          <div class="stat-content grid gap-3 md:gap-0 grid-cols-1 md:grid-cols-3 mt-4">
                            <div class="stat-block text-ice-blue gap-1 flex items-center ">
                              <Icon class="h-5" name="ph:bank-duotone" />
                              <span class="text-base">{project.price}</span>
                            </div>
                            <div class="stat-block text-ice-blue gap-1 flex items-center ">
                              <Icon class="h-5" name="ph:buildings-duotone" />
                              <span class="text-base">{project.units}</span>
                            </div>
                            <div class="stat-block text-ice-blue gap-1 flex items-center ">
                              <Icon class="h-5" name="ph:map-pin-duotone" />
                              <span class="text-base">{project.location}</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT THEY SAY -->
    <Testimonials />

    <!-- LOGOS -->
    <Logos />

    <!-- ENGAGE/CTA-->
    <EngageCTA />
  </main>
</Layout>

<script>
  import Swiper from "swiper";
  import "swiper/css";

  document.addEventListener("alpine:init", () => {
    // Home Swiper Data
    Alpine.data("homeSwiper", () => ({
      swiper: null,
      init() {
        this.swiper = new Swiper(this.$refs.container, {
          loop: true,
          autoplay: {
            delay: 5000,
          },
          slidesPerView: 1,
          spaceBetween: 0,
          effect: "fade",
          fadeEffect: {
            crossFade: true,
          },
          pagination: {
            el: ".carousel-pagination",
            type: "bullets",
          },
          breakpoints: {
            640: {
              slidesPerView: 1,
              spaceBetween: 0,
            },
            768: {
              slidesPerView: 1,
              spaceBetween: 0,
            },
            1024: {
              slidesPerView: 1,
              spaceBetween: 0,
            },
          },
        });
      },
    }));

    // ProjecstCarousel Data
    Alpine.data("projectsSwiper", () => ({
      swiper: null,
      init() {
        this.swiper = new Swiper(this.$refs.container, {
          loop: true,
          autoplay: {
            delay: 5000,
          },
          slidesPerView: 4,
          spaceBetween: 20,
          pagination: {
            el: ".carousel-pagination",
            type: "bullets",
          },
          breakpoints: {
            340: {
              slidesPerView: 1.5,
              spaceBetween: 20,
            },
            768: {
              slidesPerView: 3,
              spaceBetween: 20,
            },
            1024: {
              slidesPerView: 4,
              spaceBetween: 20,
            },
          },
        });
      },
    }));
  });
</script>
